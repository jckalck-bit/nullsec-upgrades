"use strict";
const { isMainThread } = require("node:worker_threads");
// Workers inherit NODE_OPTIONS and may inherit the world's environment before
// their entrypoint assigns the correct owner role. Never initialize this mod in
// worker threads or known child-process worker entrypoints.
const entry = String(process.argv?.[1] || '').replace(/\\/g, '/');
const ownerAtPreload = String(process.env.EVEJS_GAMESTORE_OWNER_ROLE || '').trim().toLowerCase();
if (!isMainThread || /\.worker\.(?:c?js)$/.test(entry) ||
    (ownerAtPreload && !['world','standalone'].includes(ownerAtPreload) && !entry.endsWith('/server/index.js'))) return;
const fs = require("node:fs");
const path = require("node:path");
const Module = require("node:module");

const TAG = "[Nullsec Upgrades]";
const MOD_ROOT = __dirname;
const EVEJS_ROOT = path.resolve(MOD_ROOT, "..", "..");
const CONFIG_PATH = path.join(EVEJS_ROOT, "config", "nullsec-upgrades.json");
const RESET_KEY = "resetNullSpawnedSites";
const ESCALATIONS_KEY = "miningEscalations";
const CHANCE_KEYS = { 1: "escalationChanceArray1", 2: "escalationChanceArray2", 3: "escalationChanceArray3" };
const RESPAWN_DEFAULTS = { 1: 60, 2: 260, 3: 600 };
const CHANCE_DEFAULTS = { 1: 5, 2: 15, 3: 25 };
const TIER_KEY = "tierDistribution";
const ESCALATION_LIFETIME_MS = 24 * 60 * 60 * 1000;
const ESCALATION_ORIGIN = "nullsec_escalation";
const ESCALATION_FAMILY = "nullsec_escalation";
const ESCALATION_TEMPLATE_ID = "eve-university:Interstitial_Ore_Deposit";
const ESCALATION_CLIENT_TEMPLATE_ID = "client-dungeon:11999"; // the client's own Interstitial Ore Deposit
const ESCALATION_FALLBACK_NAME_ID = 724374;
const ESCALATION_FALLBACK_DUNGEON_ID = 11999;
const ESCALATION_SLOT_FIRST = 500; // site-ID slots 500..999 of the sov_prospecting band are unused by the game
const ESCALATION_SLOT_LAST = 999;

const round2 = (value) => Math.round(value * 100) / 100;

// Every ore comes in four grades, ordered tier I -> tier IV (type IDs).
const ORE_GRADE_FAMILIES = Object.freeze([
  [1230, 17470, 17471, 46689],   // Veldspar
  [18, 17455, 17456, 46685],     // Plagioclase
  [1228, 17463, 17464, 46687],   // Scordite
  [1224, 17459, 17460, 46686],   // Pyroxeres
  [1227, 17867, 17868, 46684],   // Omber
  [20, 17452, 17453, 46683],     // Kernite
  [21, 17440, 17441, 46680],     // Hedbergite
  [22, 17425, 17426, 46678],     // Arkonor
  [1225, 17432, 17433, 46677],   // Crokite
  [1232, 17436, 17437, 46675],   // Dark Ochre
  [1223, 17428, 17429, 46676],   // Bistot
  [1229, 17865, 17866, 46679],   // Gneiss
  [1226, 17448, 17449, 46682],   // Jaspet
  [74521, 74522, 74523, 74524],  // Mordunium
  [81900, 81901, 81902, 81903],  // Kylixium
  [81975, 81976, 81977, 81978],  // Griemeer
  [82016, 82017, 82018, 82019],  // Nocxite
  [82163, 82164, 82165, 82166],  // Hezorime
  [82205, 82206, 82207, 82208],  // Ueganite
  [74529, 74530, 74531, 74532],  // Eifyrium
  [74533, 74534, 74535, 74536],  // Ducinium
]);
const ORE_FAMILY_BY_TYPE = new Map();
for (const family of ORE_GRADE_FAMILIES) family.forEach((typeID) => ORE_FAMILY_BY_TYPE.set(typeID, family));


let verbose = false;
let diagnosticState = null;
let debugStartupConfig = null;
let lastForcedTestAt = 0;
let forcedJob = null;
let debugNativeHooks = null;
function diagnosticOwner() { return verbose && isWorldOwner(); }
function activeDiagnostics() {
  if (!diagnosticOwner()) return null;
  if (!diagnosticState) {
    diagnosticState = require('./diagnostics').create(config, log);
    // Set the instance first, so mark/log cannot recurse into initialization.
    process.stdout.write(`${TAG} Verbose diagnostics initialized in world owner (PID ${process.pid}); full report in Feature Validation.\n`);
    diagnosticState.mark('verbose',true,'World-owner verbose diagnostics active');
  }
  return diagnosticState;
}
function log(message) { if (!diagnosticOwner()) return; activeDiagnostics(); process.stdout.write(`${TAG} ${message}\n`); }
function warn(message) { if (!diagnosticOwner()) return; activeDiagnostics(); process.stderr.write(`${TAG} WARNING: ${message}\n`); }

function valid(v,min,max,fallback) { return typeof v === "number" && Number.isFinite(v) && v>=min && v<=max && Math.abs(v*100-Math.round(v*100))<1e-6 ? v : fallback; }
function readConfig() {
  const config = {
    reset: false, escalations: false, tierMix: false,
    indexProgression:false,indexMultiplier:1,indexDecay:false,indexDecayRate:1,
    multipliers: { 1: 1, 2: 1, 3: 1 },
    chances: { ...CHANCE_DEFAULTS },
    anyMultiplier: false, instantRespawn: false, respawnMinutes: { ...RESPAWN_DEFAULTS },
  };
  let parsed = null;
  try {
    if (!fs.existsSync(CONFIG_PATH)) return config;
    const raw = fs.readFileSync(CONFIG_PATH, "utf8").replace(/^\uFEFF/, "");
    parsed = JSON.parse(raw);
  } catch (error) {
    warn(`Could not read ${CONFIG_PATH} (${error.message}); using defaults.`);
    return config;
  }
  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return config;
  verbose = parsed.verboseLogging === true;
  if (verbose) debugStartupConfig = parsed;
  config.commands = parsed.commands === true;
  config.indexPoints = parsed.indexPoints === true;
  config.indexEscalation = config.indexPoints && parsed.indexEscalation === true;
  config.indexResources = config.indexPoints && parsed.indexResources === true;
  config.indexProgression=parsed.industrialIndexProgression===true;
  config.indexMultiplier=valid(parsed.industrialIndexMultiplier,0,100,1);
  config.indexDecay=parsed.industrialIndexDecay===true;
  config.indexDecayRate=valid(parsed.industrialIndexDecayRate,0,100,1);
  config.mercoxit = parsed.mercoxitSites === true;
  config.mercoxitHours = Number.isSafeInteger(parsed.mercoxitRespawnHours) && parsed.mercoxitRespawnHours >= 0 && parsed.mercoxitRespawnHours <= Math.floor(Number.MAX_SAFE_INTEGER/3600000) ? parsed.mercoxitRespawnHours : 12;
  config.mercoxitMax = Number.isSafeInteger(parsed.mercoxitMaxQueued) && parsed.mercoxitMaxQueued >= 0 && parsed.mercoxitMaxQueued < Number.MAX_SAFE_INTEGER ? parsed.mercoxitMaxQueued : 3;
  config.automaticPlanetaryResources = parsed.automaticPlanetaryResources === true;
  config.instantRespawn = parsed.instantSiteRespawn === true;
  for (const tier of [1, 2, 3]) config.respawnMinutes[tier] = valid(parsed[`respawnMinutesArray${tier}`], 0, 525600, RESPAWN_DEFAULTS[tier]);
  config.strictMiningSiteSize = parsed.strictMiningSiteSize === true;
  config.arrayMix = parsed.arrayDistribution === true;
  config.randomMix = parsed.tierRandomness !== false;
  config.weights = [4,3,2,1].map((n,i) => valid(parsed['tier'+n],0,100,[50,30,15,5][i]));
  if (Math.abs(config.weights.reduce((a,b)=>a+b,0)-100)>0.000001) config.weights=[50,30,15,5];
  config.reset = parsed[RESET_KEY] === true;
  config.escalations = parsed[ESCALATIONS_KEY] === true;
  config.tierMix = parsed[TIER_KEY] === true;
  for (const tier of [1, 2, 3]) {
    config.multipliers[tier] = parsed.oreScaling === true ? 1+valid(parsed['oreScaling'+tier],0,99900,tier*10)/100 : 1;
    config.chances[tier] = valid(parsed[CHANCE_KEYS[tier]],0,100,CHANCE_DEFAULTS[tier]);
  }
  config.oreScaling = parsed.oreScaling === true;
  config.anyMultiplier = [1, 2, 3].some((tier) => config.multipliers[tier] !== 1);
  return config;
}

// Turn the reset switch off again after a successful reset, keeping every
// other byte (other keys, comments, line endings, BOM) of the file as it is.
function clearResetSwitch() {
  try {
    const original = fs.readFileSync(CONFIG_PATH, "utf8");
    const pattern = new RegExp(`("${RESET_KEY}"\\s*:\\s*)true\\b`);
    if (!pattern.test(original)) return false;
    const updated = original.replace(pattern, "$1false");
    const temporary = `${CONFIG_PATH}.${process.pid}.tmp`;
    fs.writeFileSync(temporary, updated);
    fs.renameSync(temporary, CONFIG_PATH);
    return true;
  } catch (error) {
    warn(`Could not switch "Reset mining sites" back off: ${error.message}`);
    return false;
  }
}

const config = readConfig();
config.verbose = verbose;
let targetVersion;
try { targetVersion = JSON.parse(fs.readFileSync(path.join(EVEJS_ROOT, 'config', 'version.json'), 'utf8')).evejsVersion; } catch (_) {}
if (targetVersion !== '261126.2') { warn('Unsupported EveJS version; loader not activated. Expected 261126.2.'); return; }
const diagnostics = Object.freeze({
  mark(...args) { if (diagnosticOwner()) activeDiagnostics().mark(...args); },
  snapshot() { return activeDiagnostics()?.snapshot() || []; },
  report() { return activeDiagnostics()?.report() || 'Diagnostics disabled (Verbose Logging OFF or non-world process).'; }
});
const toInt = (value, fallback = 0) => {
  const number = Number(value);
  return Number.isFinite(number) ? Math.trunc(number) : fallback;
};

function sovHubOf(instance) {
  return (instance && instance.spawnState && instance.spawnState.sovHub) ||
    (instance && instance.metadata && instance.metadata.sovHub) || null;
}

function isProspectingSite(instance) {
  if (!instance || instance.siteOrigin !== "sov_hub" || sovHubOf(instance)?.nullsecMercoxit === true) return false;
  const hub = sovHubOf(instance);
  if (hub && String(hub.upgradeCategory || "").toLowerCase() === "prospecting") return true;
  const family = (instance.metadata && instance.metadata.spawnFamilyKey) ||
    (instance.spawnState && instance.spawnState.spawnFamilyKey) || "";
  return String(family).toLowerCase() === "sov_prospecting";
}

// Prospecting Array tier (1-3) of a sov prospecting site, or of an escalation
// site it produced (which remembers the tier). 0 when it is neither.
function prospectingTier(instance) {
  if (!instance) return 0;
  const escalation = instance.spawnState && instance.spawnState.nullsecEscalation;
  if (escalation && typeof escalation === "object") return toInt(escalation.tier, 0);
  if (!isProspectingSite(instance)) return 0;
  return toInt(sovHubOf(instance) && sovHubOf(instance).upgradeTier, 0);
}

function hashFraction(text) {
  let hash = 2166136261;
  for (let i = 0; i < text.length; i += 1) {
    hash ^= text.charCodeAt(i);
    hash = Math.imul(hash, 16777619) >>> 0;
  }
  return hash / 4294967296;
}

const gradePlanCache = new Map();
const unitVolumeCache = new Map();

function unitVolumeOf(typeID) {
  if (unitVolumeCache.has(typeID)) return unitVolumeCache.get(typeID);
  let volume = 1;
  try {
    const record = typeof internals.itemByTypeID === "function" ? internals.itemByTypeID(typeID) : null;
    const value = Number(record && record.volume);
    if (Number.isFinite(value) && value > 0) volume = value;
  } catch (_) { /* fall back to 1 */ }
  unitVolumeCache.set(typeID, volume);
  return volume;
}

// Per site, by ore VOLUME (m3): rocks are handed out largest first, each to the
// grade that is furthest below its TIER_MIX share of the site's total m3, so the
// site ends up as close to 50/30/15/5 percent of its volume as whole rocks
// allow. Same site -> same answer on every load.
function mixFor(tier, rng = Math.random) {
  const base = config.arrayMix ? ({1:[30,50,15,5],2:[40,40,15,5],3:[50,30,15,5]}[tier]) : config.weights;
  let weights=base || [50,30,15,5];
  if(config.randomMix) {
    const bounds=config.arrayMix ? ({1:[[20,40],[40,60],[5,20],[0,5]],2:[[30,50],[30,50],[5,20],[0,5]],3:[[40,75],[20,40],[5,20],[0,5]]}[tier]) : weights.map(v=>[Math.max(0,v-10),Math.min(100,v+10)]);
    let remaining=100;
    weights=bounds.map(([lo,hi],i)=>{const rest=bounds.slice(i+1); const low=Math.max(lo,remaining-rest.reduce((a,b)=>a+b[1],0)); const high=Math.min(hi,remaining-rest.reduce((a,b)=>a+b[0],0)); const v=i===3?remaining:round2(low+rng()*(high-low)); remaining=round2(remaining-v); return v;});
  }
  return weights.map((v,i)=>({grade:3-i,share:v/100}));
}
function gradePlanFor(siteID, rows, instance) {
  const key = `${instance.instanceID || siteID}:${instance.timers?.createdAtMs || 0}:${rows.length}`;
  const cachedPlan = gradePlanCache.get(key);
  if (cachedPlan) return cachedPlan;
  let counter = 0;
  const TIER_MIX = mixFor(prospectingTier(instance), () => hashFraction(`${key}:${counter++}`));
  const eligible = [];
  rows.forEach((rock, index) => {
    const typeID = toInt(rock && (rock.typeID || rock.oreTypeID), 0);
    if (!ORE_FAMILY_BY_TYPE.has(typeID)) return;
    const quantity = Number(rock.quantity ?? rock.remainingQuantity ?? rock.quantityPerRock);
    const units = (Number.isFinite(quantity) && quantity > 0 ? quantity : 1) * Math.max(1, toInt(rock.count, 1));
    eligible.push({ index, m3: units * unitVolumeOf(typeID), order: hashFraction(`${siteID}:${index}`) });
  });
  eligible.sort((a, b) => b.m3 - a.m3 || a.order - b.order || a.index - b.index);
  const total = eligible.reduce((sum, entry) => sum + entry.m3, 0);
  const assigned = new Map(TIER_MIX.map((tier) => [tier.grade, 0]));
  const plan = new Map();
  for (const entry of eligible) {
    let best = TIER_MIX[0];
    let bestDeficit = -Infinity;
    for (const tier of TIER_MIX) { // TIER_MIX is ordered best grade first, so ties favour the better tier
      const deficit = tier.share * total - assigned.get(tier.grade);
      if (deficit > bestDeficit) { bestDeficit = deficit; best = tier; }
    }
    assigned.set(best.grade, assigned.get(best.grade) + entry.m3);
    plan.set(entry.index, best.grade);
  }
  if (gradePlanCache.size > 2000) gradePlanCache.clear();
  gradePlanCache.set(key, plan);
  if (verbose) {
  const sharesOK = Math.abs(TIER_MIX.reduce((n,t)=>n+t.share,0)-1)<1e-6;
  for(const feature of ["tierDistribution","arrayDistribution","tierRandomness"]) diagnostics.mark(feature,sharesOK ? null : false,"Grade plan shares checked; actual rock volumes awaiting independent verification");
  }
  return plan;
}

const internals = {
  rocks: null, // buildMiningRockEntities, handed over by the patched site service
  itemByTypeID: null, // resolveItemByTypeID, handed over by the patched site service
  pickOreType(instance, populationHints, rowIndex, original) {
    try {
      if (!isProspectingSite(instance) || prospectingTier(instance) < 1) return original;
      const family = ORE_FAMILY_BY_TYPE.get(toInt(original, 0));
      if (!family || !populationHints || !Array.isArray(populationHints.miningRocks)) return original;
      const siteID = toInt(instance.metadata && instance.metadata.siteID, 0) ||
        toInt(instance.spawnState && instance.spawnState.siteID, 0);
      if (siteID <= 0) return original;
      const grade = gradePlanFor(siteID, populationHints.miningRocks, instance).get(rowIndex);
      return grade === undefined ? original : family[grade];
    } catch (_) { return original; }
  },
  scaleQuantity(instance, quantity) {
    const multiplier = config.multipliers[instance.spawnState && instance.spawnState.nullsecEscalation ? 3 : prospectingTier(instance)];
    if (!multiplier || multiplier === 1) return quantity;
    const base = Number(quantity);
    if (!Number.isFinite(base) || base <= 0) return quantity;
    const scaled = Math.max(1, Math.round(base * multiplier));
    const result = Math.min(scaled, Number.MAX_SAFE_INTEGER);
    if (verbose) diagnostics.mark("oreScaling", Number.isSafeInteger(result) && result > 0 ? null : false, "Generated quantity arithmetic checked; live rock totals not checked");
    return result;
  },
};
// Called from the patched ore quantity line.
globalThis.__nullsecUpgrades = internals;

// Strict sizes: the bundled client content calls medium deposits simply "<ore> Deposit".
// Match complete names, not substring ranks, so no wrong-size fallback is possible.
function patchStrictProspectingSizes(source) {
  const filterAnchor = '    .sort((left, right) => {\n      const leftName = normalizeLowerText(left && (left.resolvedName || left.name), "");';
  const functionStart = source.indexOf('function listProspectingOreTemplates(mineral, tier) {');
  const functionEnd = source.indexOf('\nfunction getStargateAdjacency()', functionStart);
  if (functionStart < 0 || functionEnd < 0) throw new Error('Strict mining size: unsupported prospecting selector');
  const section = source.slice(functionStart, functionEnd);
  if (section.split(filterAnchor).length !== 2) throw new Error('Strict mining size: selector anchor mismatch');
  const filter = `    .filter((template) => {
      const name = normalizeLowerText(template && (template.resolvedName || template.name), "");
      const level = toInt(tier, 0);
      return oreNames.some((oreName) => {
        const ore = normalizeLowerText(oreName, "");
        if (level === 1) return name === "small " + ore + " deposit";
        if (level === 2) return [ore + " deposit", "medium " + ore + " deposit", "average " + ore + " deposit"].includes(name);
        if (level === 3) return name === "large " + ore + " deposit";
        return false;
      });
    })
`;
  let patched = source.slice(0, functionStart) + section.replace(filterAnchor, filter + filterAnchor) + source.slice(functionEnd);

  return patched;
}

// Use the native persistent lifecycle deadline and scheduler, not a new polling loop.
internals.isStandardProspecting = instance => instance?.siteOrigin === "sov_hub" && isProspectingSite(instance);
internals.respawnDelay = (instance, original) => {
  if (!internals.isStandardProspecting(instance)) return original;
  const tier = prospectingTier(instance);
  return config.instantRespawn ? 0 : (config.respawnMinutes[tier] ?? RESPAWN_DEFAULTS[3]) * 60000;
};

// Natural system resources replace (never add to) physical local production.
const naturalResourceCache = new WeakMap();
const indexBenefits = require('./index-benefits').create(config,log,warn,diagnostics);
internals.virtualResourcesEnabled = () => config.automaticPlanetaryResources === true;
internals.boostResources = indexBenefits.boostResources;
internals.getIndexPoints = indexBenefits.getIndexPoints;
internals.naturalResources = (snapshot, systemID) => {
  if (!snapshot || !snapshot.planetsBySolarSystemID?.has(systemID) || !snapshot.starConfigurationsBySolarSystemID?.has(systemID)) return null;
  let cache = naturalResourceCache.get(snapshot);
  if (!cache) { cache = new Map(); naturalResourceCache.set(snapshot, cache); }
  if (cache.has(systemID)) return cache.get(systemID);
  const star = snapshot.starConfigurationsBySolarSystemID.get(systemID);
  let power = Number(star?.power) || 0, workforce = 0;
  for (const id of new Set(snapshot.planetsBySolarSystemID.get(systemID))) {
    const planet = snapshot.planetDefinitionsByPlanetID.get(id);
    if (!planet) return null;
    power += Number(planet.power) || 0;
    workforce += Number(planet.workforce) || 0;
  }
  const result = Object.freeze({ power, workforce });
  cache.set(systemID, result);
  if (verbose) diagnostics.mark("planetaryResources",Number.isFinite(power)&&Number.isFinite(workforce)&&power>=0&&workforce>=0?null:false,"Natural resource totals calculated; native final accounting not independently checked");
  if (verbose) log(`Automatic planetary resources: system ${systemID}, power ${power}, workforce ${workforce}.`);
  return result;
};
function patchPlanetaryResources(source) {
  source = source.replace(/\r\n/g, "\n");
  const anchor = '  const harvested = stateCache.localHarvestBySolarSystemID.get(solarSystemID) || null;';
  const denAnchor = '    localHarvest.workforce += Math.max(0, Number(contribution.workforce || 0) - denSiphon);';
  if (source.split(anchor).length !== 2 || source.split(denAnchor).length !== 2) throw new Error("unsupported local harvest anchors");
  const start = source.indexOf(anchor), end = source.indexOf('\n}', start);
  if (end < 0) throw new Error('local harvest boundary unavailable');
  const native = source.slice(start,end).replace('  return {','  const local = {');
  let patched = source.slice(0,start) + `${native}
  let virtual = null;
  try { if(globalThis.__nullsecUpgrades.virtualResourcesEnabled()) virtual = globalThis.__nullsecUpgrades.naturalResources(stateCache.staticSnapshot, solarSystemID); } catch (_) {}
  if (virtual) virtual = {power:virtual.power, workforce:Math.max(0,virtual.workforce-(stateCache.nullsecDenSiphons?.get(solarSystemID)||0))};
  return globalThis.__nullsecUpgrades.boostResources(solarSystemID, virtual || local);` + source.slice(end);
  if (config.automaticPlanetaryResources) patched = patched.replace(denAnchor,denAnchor+`
    if (denSiphon > 0) {
      const natural = Number(staticSnapshot.planetDefinitionsByPlanetID.get(normalizedSkyhook.planetID)?.workforce)||0;
      const deduction = Math.min(Math.max(0,natural),denSiphon);
      nextCache.nullsecDenSiphons ||= new Map();
      nextCache.nullsecDenSiphons.set(normalizedSkyhook.solarSystemID,(nextCache.nullsecDenSiphons.get(normalizedSkyhook.solarSystemID)||0)+deduction);
    }`);
  if(verbose) patched += `
;globalThis.__nullsecUpgrades.debugResourceSnapshot = function(systemID) {
    if(!cache) return null;
    const hub=[...cache.hubsByID.values()].find(h=>h.solarSystemID===systemID);
    if(!hub)return null;
    const resources=cache.hubSnapshotsByID.get(hub.hubID)?.resources;
    if(!resources)return null;
    const ss=cache.staticSnapshot, star=ss.starConfigurationsBySolarSystemID.get(systemID), ids=ss.planetsBySolarSystemID.get(systemID);
    const harvested=cache.localHarvestBySolarSystemID.get(systemID);
    let power=Number(harvested?.power)||Number(star?.power)||0, workforce=Number(harvested?.workforce)||0;
    if(globalThis.__nullsecUpgrades.virtualResourcesEnabled() && ids && star){
      power=Number(star.power)||0;workforce=0;
      for(const id of new Set(ids)){const planet=ss.planetDefinitionsByPlanetID.get(id);if(!planet)return null;power+=Number(planet.power)||0;workforce+=Number(planet.workforce)||0;}
      workforce=Math.max(0,workforce-(cache.nullsecDenSiphons?.get(systemID)||0));
    }
    return {power,workforce,transfer:getHubTransferDelta(hub,cache),actual:resources};
  };`;
  return patched;
}

function validSource(source, filename) {
  try { new (require("node:vm").Script)(Module.wrap(source), { filename }); return true; }
  catch (error) { warn(`Transformation rejected for ${filename}: ${error.message}`); return false; }
}

function patchFirstSpawnWait(source) {
  source=source.replace(/\r\n/g,'\n');
  const anchor='  const category = getUpgradeCategory(getUpgradeName(upgrade));';
  if(source.split(anchor).length!==2)throw Error('Native first spawn wait anchor mismatch');
  return source.replace(anchor,anchor+`
  if (category === "prospecting") {
    const tier = /\\bprospecting array ([123])\\b/i.exec(getUpgradeName(upgrade));
    if (tier && (${JSON.stringify(config.instantRespawn)} || ${JSON.stringify(config.respawnMinutes)}[Number(tier[1])] === 0)) return null;
  }`);
}
let lifecyclePlanReady = false, visibilityPatchReady = false;
function isWorldOwner(){ const role=String(process.env.EVEJS_GAMESTORE_OWNER_ROLE||'').trim().toLowerCase(); return role==='world'||role==='standalone'||(!role&&process.env.EVEJS_TEST_STORE_ISOLATED==='1'); }
// ---------------------------------------------------------------- 1. quantity
const QUANTITY_PATTERN =
  /const quantity = exactClientContent\s*\?\s*(Math\.max\(0, toFiniteNumber\(rawQuantity, 0\)\))\s*:\s*(Math\.max\(1, toInt\(rawQuantity, 1_000\)\));/g;
const ORE_TYPE_PATTERN = /const oreTypeID = resolveMiningRockTypeID\(rock, instance\);/g;

{
  const originalCompile = Module.prototype._compile;
  let lifecyclePending = true;
  let firstSpawnPending = true;
  let mercoxitPending = config.mercoxit === true;
  let strictPending = config.strictMiningSiteSize === true;
  let orePending = true;
  let resourcesPending = config.automaticPlanetaryResources === true || config.indexResources === true;
  Module.prototype._compile = function patchedCompile(content, filename) {
    if(!isWorldOwner())return originalCompile.call(this,content,filename);
    const normalized=normalizedPath(filename);
    if(firstSpawnPending && normalized.endsWith('/services/dungeon/dungeonSiteSpawnPolicy.js')) {
      firstSpawnPending=false;
      try {const candidate=patchFirstSpawnWait(content);if(!validSource(candidate,filename))throw Error('Invalid first spawn transform');content=candidate;log('Prospecting first-spawn policy installed.');}
      catch(e){if(verbose)diagnostics.mark('initialSpawn',false,'Native first-spawn transform rejected');warn(e.message);}
    }
    if (resourcesPending && normalized.endsWith("/services/sovereignty/sovModernState.js")) {
      resourcesPending = false;
      try {
        const candidate = patchPlanetaryResources(content);
        if (validSource(candidate, filename)) { content = candidate; log("Automatic planetary resources hook installed."); } else throw new Error("Resource transform syntax invalid");
      } catch (error) { if(verbose){diagnostics.mark("planetaryResources",false,"Native resource hook rejected");diagnostics.mark("indexResources",false,"Native resource hook rejected");} warn(`Automatic planetary resources skipped: ${error.message}`); }
    }
    if (lifecyclePending && normalized.endsWith("/services/dungeon/dungeonUniverseRuntime.js")) {
      lifecyclePending=false;
      try { const candidate=patchIndependentReplacement(content); if(validSource(candidate,filename)){content=candidate;lifecyclePlanReady=true;log('Independent replacement plan installed.');}else throw new Error('Replacement transform syntax invalid'); }catch(e){if(verbose){diagnostics.mark('respawn',false,'Independent replacement hook rejected');diagnostics.mark('instantRespawn',false,'Independent replacement hook rejected');}warn(`Independent replacement skipped: ${e.message}`);}
    }
    if (mercoxitPending && normalized.endsWith("/services/dungeon/dungeonUniverseRuntime.js")) {
      mercoxitPending=false;
      try { const candidate=patchMercoxit(content.replace(/\r\n/g,"\n")); if(validSource(candidate,filename)){content=candidate;log("Mercoxit hook installed.");}else throw new Error("Mercoxit transform syntax invalid"); } catch(e){if(verbose)diagnostics.mark("mercoxit",false,"Native Mercoxit hook rejected");warn(`Mercoxit hook skipped: ${e.message}`);}
    }
    if (strictPending && normalized.endsWith("/services/dungeon/dungeonUniverseRuntime.js")) {
      try { const candidate = patchStrictProspectingSizes(content.replace(/\r\n/g, "\n")); if (validSource(candidate, filename)) { content = candidate; log("Strict mining site size active."); }else throw new Error("Strict-size transform syntax invalid"); } catch (error) { if(verbose)diagnostics.mark("strictSize",false,"Native strict-size hook rejected");warn(`Strict size patch skipped: ${error.message}`); }
      strictPending = false;
    }
    if (typeof filename === "string" &&
        normalized.endsWith("/services/dungeon/dungeonUniverseSiteService.js")) {
      let patched = content, visibilityCandidate = false;
      try { const candidate=patchLogicalVisibility(patched);if(validSource(candidate,filename)){patched=candidate;visibilityCandidate=true;log('Occupied grid visibility hook installed.');}else throw new Error('Visibility transform syntax invalid');}catch(e){if(verbose){diagnostics.mark("respawn",false,"Native visibility hook rejected");diagnostics.mark("instantRespawn",false,"Native visibility hook rejected");}warn(`Logical visibility hook skipped: ${e.message}`);}

      if (config.anyMultiplier) {
        let matches = 0;
        const next = patched.replace(QUANTITY_PATTERN, (_whole, exact, normal) => {
          matches += 1;
          return "const quantity = globalThis.__nullsecUpgrades.scaleQuantity(instance, " +
            `exactClientContent ? ${exact} : ${normal});`;
        });
        if (matches > 0) {
          patched = next;
          log(`Ore multipliers active: Array 1 x${config.multipliers[1]}, Array 2 x${config.multipliers[2]}, Array 3 x${config.multipliers[3]} (${matches} ore quantity site(s) patched).`);
        } else {
          if(verbose)diagnostics.mark("oreScaling",false,"Native ore quantity anchor not found");
          warn("Could not find the ore quantity code in this EveJS version; the Prospecting Array multipliers are NOT active.");
        }
      } else {
        if(verbose && config.oreScaling)diagnostics.mark("oreScaling",true,"Configured multipliers are all 1; native quantities retained");
        log("All Prospecting Array multipliers are 1: ore volumes unchanged.");
      }

      if (config.tierMix) {
        let tierMatches = 0;
        const withTiers = patched.replace(ORE_TYPE_PATTERN, () => {
          tierMatches += 1;
          return "const oreTypeID = globalThis.__nullsecUpgrades.pickOreType(instance, populationHints, " +
            "rockRowIndex, resolveMiningRockTypeID(rock, instance));";
        });
        if (tierMatches > 0) {
          patched = withTiers;
          log("Mining site tier distribution active for Prospecting Array sites: 50% tier IV, 30% tier III, 15% tier II, 5% tier I.");
        } else {
          if(verbose)for(const feature of ["tierDistribution","arrayDistribution","tierRandomness"])diagnostics.mark(feature,false,"Native ore type anchor not found");
          warn("Could not find the ore type code in this EveJS version; Mining site tier distribution is NOT active.");
        }
      }

      let appended = "";
      if (config.tierMix) {
        if (/\bresolveItemByTypeID\b/.test(patched)) appended += "\n;globalThis.__nullsecUpgrades.itemByTypeID = resolveItemByTypeID;";
        else warn("Could not find the item lookup in this EveJS version; Mining site tier distribution will weigh rocks by quantity instead of m3.");
      }
      if (verbose) {
        // Compare two executions of the same native descriptor generator, one with mod transformations omitted.
        const begin=patched.indexOf('function listMiningObjectiveRockDescriptors(instance, populationHints) {');
        const end=patched.indexOf('\n// A captured object',begin);
        if(begin>=0&&end>begin){
          let section=patched.slice(begin,end).replace('function listMiningObjectiveRockDescriptors(instance, populationHints) {','function listMiningObjectiveRockDescriptors(instance, populationHints, nullsecNativeBaseline = false) {');
          section=section.replace('globalThis.__nullsecUpgrades.pickOreType(instance, populationHints, rockRowIndex, resolveMiningRockTypeID(rock, instance))','(nullsecNativeBaseline ? resolveMiningRockTypeID(rock, instance) : globalThis.__nullsecUpgrades.pickOreType(instance, populationHints, rockRowIndex, resolveMiningRockTypeID(rock, instance)))');
          section=section.replace(/globalThis\.__nullsecUpgrades\.scaleQuantity\(instance, (exactClientContent \? [^;]+)\);/, '($1);');
          // Preserve original scaled expression on normal calls.
          const orig=patched.slice(begin,end).match(/globalThis\.__nullsecUpgrades\.scaleQuantity\(instance, (exactClientContent \? [^;]+)\);/);
          if(orig) section=section.replace('const quantity = ('+orig[1]+');','const quantity = nullsecNativeBaseline ? ('+orig[1]+') : globalThis.__nullsecUpgrades.scaleQuantity(instance, '+orig[1]+');');
          patched=patched.slice(0,begin)+section+patched.slice(end);
          appended += '\n;globalThis.__nullsecUpgrades.debugRockDescriptors = listMiningObjectiveRockDescriptors;globalThis.__nullsecUpgrades.itemByTypeID = resolveItemByTypeID;';
        }
      }
      if (appended) patched += appended + "\n";
      if (validSource(patched, filename)) {content = patched;visibilityPatchReady=visibilityCandidate;}
      else if(verbose)for(const feature of ['respawn','instantRespawn','oreScaling','tierDistribution','arrayDistribution','tierRandomness'])diagnostics.mark(feature,false,'Native site service transform failed syntax validation');
      orePending = false;
    }
    if (!firstSpawnPending && !lifecyclePending && !strictPending && !orePending && !mercoxitPending && !resourcesPending && Module.prototype._compile === patchedCompile) Module.prototype._compile = originalCompile;
    const compiled=originalCompile.call(this, content, filename);
    if(diagnosticOwner()) {
      debugNativeHooks ||= new Map();
      if(normalized.endsWith('/services/dungeon/dungeonSiteSpawnPolicy.js')) {
        debugNativeHooks.set('initialSpawn',content.includes('if (tier && ('));
      }else if(normalized.endsWith('/services/dungeon/dungeonUniverseRuntime.js')) {
        debugNativeHooks.set('replacement',content.includes('globalThis.__nullsecUpgrades.planProspectingSlot('));
        debugNativeHooks.set('mercoxit',content.includes('globalThis.__nullsecUpgrades.mercoxitDefinition('));
        debugNativeHooks.set('strictSize',content.includes('if (level === 1) return name === "small "'));
      }else if(normalized.endsWith('/services/dungeon/dungeonUniverseSiteService.js')) {
        debugNativeHooks.set('visibility',content.includes('globalThis.__nullsecUpgrades.hideDepletedRoot(next)'));
        debugNativeHooks.set('oreScaling',(content.match(/__nullsecUpgrades\.scaleQuantity\(instance/g)||[]).length===2);
        debugNativeHooks.set('tierDistribution',(content.match(/__nullsecUpgrades\.pickOreType\(instance/g)||[]).length===2 && typeof internals.itemByTypeID==='function');
      }else if(normalized.endsWith('/services/sovereignty/sovModernState.js')) {
        debugNativeHooks.set('resources',content.includes('globalThis.__nullsecUpgrades.boostResources(solarSystemID, virtual || local)'));
      }
    }
    return compiled;
  };
}

// ------------------------------------------------------------------- 2. reset
const SITE_STATES = ["seeded", "active", "paused", "completed", "failed", "despawned"];

function resetProspectingSites(dungeonRuntime) {
  const seen = new Set();
  const ids = [];
  for (const state of SITE_STATES) {
    for (const instance of dungeonRuntime.listInstancesByLifecycle(state, { full: true })) {
      const id = toInt(instance && instance.instanceID, 0);
      if (id <= 0 || seen.has(id)) continue;
      seen.add(id);
      if (!(instance.runtimeFlags && instance.runtimeFlags.universeSeeded === true)) continue;
      if (String(instance.siteOrigin || "").toLowerCase() !== "sov_hub") continue;
      if (isProspectingSite(instance)) {
        const runtime = require(path.join(EVEJS_ROOT, "server", "src", "space", "runtime"));
        const scene = runtime.scenes?.get(instance.solarSystemID);
        if (scene) {
          const service = require(path.join(SERVER_SERVICES, "dungeon", "dungeonUniverseSiteService"));
          const occupied = service.homefrontPorts?.occupied;
          if (typeof occupied !== "function" || occupied(scene, instance, instance.metadata?.siteID || instance.spawnState?.siteID)) throw new Error(`Site ${id} occupied or occupancy unknown; reset postponed`);
        }
        ids.push(id);
      }
    }
  }
  const result = ids.length > 0
    ? dungeonRuntime.purgeInstances(ids, { source: "nullsec-upgrades" })
    : { removedCount: 0 };
  const removed = toInt(result && result.removedCount, 0);
  if (removed !== ids.length) throw new Error(`Reset incomplete: ${removed}/${ids.length} sites removed`);
  return removed;
}



// ------------------------------------------------- highest ore grade
// Fixed highest grade for every ore in the Interstitial Ore Deposit
// (base type ID -> highest grade type ID). Nothing is looked up at runtime.
const TOP_GRADE_BY_ORE = new Map([
  [52316, 56628], // Bezdnacine   -> Bezdnacine Grade-III
  [52315, 56630], // Rakovene     -> Rakovene Grade-III
  [52306, 56626], // Talassonite  -> Talassonite Grade-III
  [19, 46688],    // Spodumain    -> Spodumain Grade-IV
  [11396, 17870], // Mercoxit     -> Mercoxit Grade-III
]);

function topGradeTypeID(typeID) {
  const original = toInt(typeID, 0);
  return TOP_GRADE_BY_ORE.get(original) || original;
}

function withTopGradeOre(populationHints) {
  const hints = JSON.parse(JSON.stringify(populationHints || {}));
  if (Array.isArray(hints.miningRocks)) {
    for (const rock of hints.miningRocks) {
      if (!rock) continue;
      if (rock.typeID) rock.typeID = topGradeTypeID(rock.typeID);
      if (rock.oreTypeID) rock.oreTypeID = topGradeTypeID(rock.oreTypeID);
    }
  }
  return hints;
}

// ------------------------------------------------- telling the player(s)
const FILETIME_EPOCH_OFFSET_MS = 11644473600000n;
function msToFiletime(ms) { return ((BigInt(Math.trunc(ms)) + FILETIME_EPOCH_OFFSET_MS) * 10000n).toString(); }

function sessionsInSystem(systemID) {
  try {
    const registry = require(path.join(getUniverseRuntime().__dir, "..", "chat", "sessionRegistry"));
    return Array.from(registry.getSessions()).filter((session) => session &&
      toInt(session.characterID || session.charid, 0) > 0 && resolveSessionSystemID(session) === systemID);
  } catch (error) {
    warn(`Could not list sessions in system ${systemID}: ${error.message}`);
    return [];
  }
}

function describeSite(created) {
  let systemName = `system ${created.solarSystemID}`;
  let siteName = "ore site";
  try {
    const worldData = require(path.join(getUniverseRuntime().__dir, "..", "..", "space", "worldData"));
    const system = worldData.getSolarSystemByID(created.solarSystemID);
    if (system && (system.solarSystemName || system.name)) systemName = system.solarSystemName || system.name;
  } catch (_) { /* keep the id */ }
  try {
    const authority = require(path.join(getUniverseRuntime().__dir, "dungeonAuthority"));
    const template = authority.getTemplateByIDReadOnly
      ? authority.getTemplateByIDReadOnly(created.templateID) : authority.getTemplateByID(created.templateID);
    if (template && (template.resolvedName || template.title)) siteName = template.resolvedName || template.title;
  } catch (_) { /* keep the generic name */ }
  return { systemName, siteName };
}

function notifyEscalation(created, recipients) {
  if (!recipients.length) return;
  let chatHub = null;
  try { chatHub = require(path.join(getUniverseRuntime().__dir, "..", "chat", "chatHub")); } catch (_) { /* no chat */ }
  if (!chatHub || typeof chatHub.sendSystemMessage !== "function") return;
  const { systemName, siteName } = describeSite(created);
  const message = `Mining escalation! ${siteName} has appeared in ${systemName}. ` +
    `Expires ${new Date(Date.now()+ESCALATION_LIFETIME_MS).toISOString()}. Check your probe scanner or Journal.`;
  for (const session of recipients) {
    try { chatHub.sendSystemMessage(session, message); } catch (_) { /* never break the caller */ }
  }
}

// Creates the escalation site and tells everyone in the system. `extraSession`
// (the /miningescalation caller) is always told and always gets the entry.
function spawnEscalation(parent, extraSession = null) {
  const systemID = toInt(parent.solarSystemID, 0);
  const recipients = sessionsInSystem(systemID);
  if (extraSession && !recipients.includes(extraSession)) recipients.push(extraSession);
  const characterIDs = [...new Set(recipients.map((session) => toInt(session.characterID || session.charid, 0)).filter((id) => id > 0))];
  const built = buildEscalationSite(getDungeonRuntime(), getUniverseRuntime(), parent, Date.now(), characterIDs);
  const created = createEscalationInstance(getUniverseRuntime(), built);
  notifyEscalation(created, recipients);
  return created;
}

// Rows for the Journal's escalating-path list (GetMyEscalatingPathDetails).
function escalationRowsFor(session) {
  const characterID = toInt(session && (session.characterID || session.charid), 0);
  if (characterID <= 0) return [];
  const dungeonRuntime = getDungeonRuntime();
  const systemID = resolveSessionSystemID(session);
  const now = Date.now();
  const rows = [];
  for (const state of ["seeded", "active", "paused"]) {
    for (const instance of dungeonRuntime.listInstancesByLifecycle(state, { full: true })) {
      if (!instance || String(instance.siteOrigin || "").toLowerCase() !== ESCALATION_ORIGIN) continue;
      const expiresAtMs = toInt(instance.timers && instance.timers.expiresAtMs, 0);
      if (expiresAtMs <= now) continue;
      const info = (instance.spawnState && instance.spawnState.nullsecEscalation) || {};
      const mine = Array.isArray(info.characterIDs) && info.characterIDs.includes(characterID);
      if (!mine && toInt(instance.solarSystemID, 0) !== systemID) continue;
      const dungeonID = toInt(info.clientDungeonID, 0) || ESCALATION_FALLBACK_DUNGEON_ID;
      rows.push([
        toInt(instance.instanceID, 0),
        dungeonID,
        dungeonID,
        dungeonID,
        { type: "long", value: msToFiletime(expiresAtMs) },
        null,
      ]);
    }
  }
  return rows;
}

// ------------------------------------------------------------ 3. escalations
// Mod-owned durable state. One atomic rename per transaction; no background polling.
const STATE_PATH = path.join(path.dirname(CONFIG_PATH), "nullsec-upgrades-state.json");
let durableState = null;
let stateUnavailable = false;
function loadState() {
  if (durableState) return durableState;
  if (stateUnavailable) throw new Error("mod state unavailable");
  try {
    const state = fs.existsSync(STATE_PATH) ? JSON.parse(fs.readFileSync(STATE_PATH, "utf8")) : { version: 1, cooldowns: {}, queue: {} };
    if (state.version !== 1 || !state.cooldowns || Array.isArray(state.cooldowns) || !state.queue || typeof state.queue !== "object") throw new Error("unsupported state format");
    if (Array.isArray(state.queue)) { const counts = {}; for (const row of state.queue) counts[row.systemID] = (counts[row.systemID] || 0) + 1; state.queue = counts; }
    durableState = state;
    return state;
  } catch (error) { stateUnavailable = true; warn(`Persistent state disabled: ${error.message}`); throw error; }
}
function mutateState(fn) {
  const next = JSON.parse(JSON.stringify(loadState()));
  const result = fn(next);
  fs.mkdirSync(path.dirname(STATE_PATH), { recursive: true });
  const temp = `${STATE_PATH}.${process.pid}.tmp`;
  let fd;
  try {
    fd = fs.openSync(temp, "w", 0o600);
    fs.writeFileSync(fd, JSON.stringify(next)); fs.fsyncSync(fd); fs.closeSync(fd); fd = undefined;
    fs.renameSync(temp, STATE_PATH);
  } finally { if (fd !== undefined) fs.closeSync(fd); try { fs.unlinkSync(temp); } catch (_) {} }
  durableState = next;
  return result;
}
function logicalReady(){return lifecyclePlanReady && visibilityPatchReady;}
function managedDepleted(site){return !!site && site.lifecycleState==='completed' && site.lifecycleReason==='depleted' && (isProspectingSite(site)||isMercoxitSite(site)||site.siteOrigin===ESCALATION_ORIGIN);}
internals.hideDepletedRoot = managedDepleted;
internals.retireDepletedSlot = site => logicalReady() && managedDepleted(site) && (isProspectingSite(site)||isMercoxitSite(site));
function positionClear(position, others){
  const p = position && [position.x,position.y,position.z].map(Number);
  if (!p || !p.every(Number.isFinite)) return false;
  return others.every(row=>{
    const q=row.position && [row.position.x,row.position.y,row.position.z].map(Number);
    return q && q.every(Number.isFinite) && Math.hypot(p[0]-q[0],p[1]-q[1],p[2]-q[2])>1000000;
  });
}
// Stable active slot; fresh slots only when creating a replacement. Reserve 50..99 for
// standard prospecting replacements, 100..499 for Mercoxit, 500..999 for escalations.
// A slot is never reused while any native instance still names its ID.
function selectFreeSlot({rows, system, preferred, first, last, rotation, claimed, siteID, placement}) {
  const used = new Set(rows.map(r=>Number(r.metadata?.siteID || r.spawnState?.siteID)).filter(Number.isSafeInteger));
  const candidates = [preferred]; for(let i=first;i<=last;i++)if(i!==preferred)candidates.push(i);
  for (const slot of candidates){
    if (!Number.isInteger(slot)||slot<0||slot>=1000||claimed.has(slot)||used.has(siteID('sov_prospecting',system,slot))) continue;
    const p=placement(system,'sov_prospecting',slot,rotation)?.position;
    if(positionClear(p,rows.filter(r=>r.position))) {claimed.add(slot);return slot;}
  }
  return null;
}
internals.planProspectingSlot = (system,hubID,upgradeTypeID,baseSlot,nativeRotation,now,claimed,siteID,placement) => {
  if (!logicalReady()) return {slot:baseSlot,rotation:nativeRotation};
  try {
    const key=`${system}:${upgradeTypeID}`, state=loadState(), rows=getDungeonRuntime().listInstancesBySystem(system);
    const matching=rows.filter(r=>isProspectingSite(r)&&Number(sovHubOf(r)?.upgradeTypeID)===Number(upgradeTypeID)&&Number(sovHubOf(r)?.sourceHubID)===Number(hubID));
    const current=matching.find(r=>['active','seeded','paused'].includes(r.lifecycleState)) || matching.find(r=>!managedDepleted(r));
    if(current){const slot=Number(current.metadata?.slotIndex);if(!Number.isInteger(slot)||claimed.has(slot))return null;claimed.add(slot);return {slot,rotation:Number(current.metadata?.rotationIndex)||0};}
    const terminal=matching.filter(managedDepleted);
    const latest=terminal.reduce((best,r)=>!best||Number(r.metadata?.rotationIndex)>Number(best.metadata?.rotationIndex)?r:best,null);
    const recorded=state.rotations?.[key];
    const rotation=Math.max(nativeRotation, recorded?.hub===Number(hubID)?Number(recorded.next)||0:0,latest?Number(latest.metadata?.rotationIndex||0)+1:0);
    const recoveredDeadline=latest ? Number(latest.timers?.completedAtMs||latest.timers?.lastUpdatedAtMs||now)+internals.respawnDelay(latest,0):0;
    // Recover only the newest not-yet-journaled completion, never resurrect a previous cooldown after a replacement.
    if(latest && (!recorded || recorded.hub!==Number(hubID) || Number(recorded.lastInstance)<Number(latest.instanceID)))recordCooldown(latest,recoveredDeadline);
    if((Number(loadState().cooldowns[key])||0)>Math.max(now,Date.now())) return null;
    if(baseSlot>=50) return null; // avoid reserved ranges if upstream changes its allocation scheme
    const slot=selectFreeSlot({rows,system,preferred:baseSlot,first:50,last:99,rotation,claimed,siteID,placement});
    if(slot===null){warn('No clear replacement slot; native terminal grid remains protected.');return null;}
    return {slot,rotation};
  }catch(e){warn(`Prospecting slot planning failed: ${e.message}`);return null;}
};
function patchIndependentReplacement(source){
  source=source.replace(/\r\n/g,'\n');
  const start=source.indexOf('function buildProspectingDefinitionsForSystem('), end=source.indexOf('\nfunction listSovereigntySourceSystemIDs()',start);
  if(start<0||end<0)throw new Error('prospecting definition anchors missing');
  let section=source.slice(start,end);
  const a='  const upgrades = listParsedOnlineUpgrades(normalizedContext, parseProspectingUpgrade);';
  const b=`    const slotIndex = allocateSovSlotIndex(slotAllocations, "sov_prospecting", systemID);
    const rotationIndex = resolveDesiredSovSlotRotationIndex(
      options,
      "sov_prospecting",
      systemID,
      slotIndex,
    );`;
  if(section.split(a).length!==2||section.split(b).length!==2)throw new Error('prospecting slot anchors mismatch');
  section=section.replace(a,a+'\n  const nullsecClaimedSlots = new Set();');
  section=section.replace(b,`    const nativeSlot = allocateSovSlotIndex(slotAllocations, "sov_prospecting", systemID);
    const nativeRotation = resolveDesiredSovSlotRotationIndex(options,"sov_prospecting",systemID,nativeSlot);
    const nullsecSlot = globalThis.__nullsecUpgrades.planProspectingSlot(systemID,normalizedContext.sovereignty.hubID,toInt(upgrade.upgrade && upgrade.upgrade.typeID,0),nativeSlot,nativeRotation,nowMs,nullsecClaimedSlots,buildUniverseSiteID,buildUniverseSitePlacement);
    if (!nullsecSlot) continue;
    const slotIndex = nullsecSlot.slot, rotationIndex = nullsecSlot.rotation;`);
  source=source.slice(0,start)+section+source.slice(end);
  const rotationAnchor='function buildSovereigntyRotationDefinitionFromInstance(\n  instance,\n  nowMs = Date.now(),\n  options = {},\n) {';
  if(source.split(rotationAnchor).length!==2)throw new Error('native rotation anchor mismatch');
  return source.replace(rotationAnchor,rotationAnchor+'\n  if (globalThis.__nullsecUpgrades.retireDepletedSlot(instance)) return null;');
}
function patchLogicalVisibility(source){
  const a='if (["tale-slot", "tale-final"].includes(previous.metadata?.incursionAdmission?.placement)) {';
  if(source.split(a).length!==2)throw new Error('native occupied root visibility anchor mismatch');
  return source.replace(a,'if (["tale-slot", "tale-final"].includes(previous.metadata?.incursionAdmission?.placement) || (next && globalThis.__nullsecUpgrades.hideDepletedRoot(next))) {');
}
function upgradeKey(site) {
  if (!isProspectingSite(site)) return null;
  const hub = sovHubOf(site);
  const system = Number(hub?.sourceSystemID || site.solarSystemID), type = Number(hub?.upgradeTypeID);
  return system > 0 && type > 0 ? `${system}:${type}` : null;
}
// Mercoxit reserves are separate from standard Array cooldowns and escalation rolls.
const deadlines = new Map();
let deadlineTimer;
function armDeadlines() {
  if(deadlineTimer) clearTimeout(deadlineTimer);
  deadlineTimer = undefined;
  if(!deadlines.size) return;
  let earliest=Infinity; for(const row of deadlines.values()) earliest=Math.min(earliest,row.at);
  deadlineTimer=setTimeout(()=>{
    const now=Date.now(), systems=new Set();
    for(const [key,row] of deadlines) if(row.at<=now){deadlines.delete(key);systems.add(row.system);}
    for(const system of systems) try { getUniverseRuntime().scheduleSystemUniversePersistentSitesReconcile(system,{reason:'nullsec-deadline',families:['sov_prospecting'],force:true,debounceMs:0}); } catch(e){warn(`Deadline reconcile failed: ${e.message}`);}
    armDeadlines();
  },Math.min(2147483647,Math.max(1,earliest-Date.now()))); deadlineTimer.unref();
}
function setDeadline(kind,key,at){const id=kind+':'+key;if(at>0) deadlines.set(id,{at,system:Number(key.split(':')[0])});else deadlines.delete(id);armDeadlines();}
function mercoxitKey(hub) { return `${hub.sourceSystemID}:${hub.upgradeTypeID}`; }
function isMercoxitSite(site) { return sovHubOf(site)?.nullsecMercoxit === true; }
function mercoxitWake(key,deadline){setDeadline('mercoxit',key,config.mercoxit?deadline:0);}
function mercoxitAdvance(row, now, active) {
  const interval = config.mercoxitHours * 3600000;
  const cap = config.mercoxitMax + (active ? 0 : 1);
  row.ready = Math.min(row.ready, cap);
  if (!interval) { row.ready = cap; row.deadline = 0; return; }
  if (row.ready >= cap) { row.deadline = 0; return; }
  if (!row.deadline) row.deadline = now + interval;
  if (row.deadline <= now) {
    const count = Math.min(cap-row.ready, 1+Math.floor((now-row.deadline)/interval));
    row.ready += count; row.deadline += count*interval;
    if (row.ready >= cap) row.deadline = 0;
  }
}
function mercoxitPlan(hub, now, active) {
  if (!config.mercoxit || !hub.upgradeTypeID) return null;
  const key = mercoxitKey(hub);
  const state = loadState();
  let row = state.mercoxit?.[key];
  if (!row) {
    const used = new Set(Object.entries(state.mercoxit || {}).filter(([k])=>k.startsWith(`${hub.sourceSystemID}:`)).map(([,v])=>v.slot));
    let slot=100; while (used.has(slot) && slot<500) slot++;
    if (slot>=500) throw new Error('No free Mercoxit slot');
    row={slot,ready:active?0:1,deadline:0,rotation:0,lastInstance:0};
  }
  const next={...row}; mercoxitAdvance(next,now,active);
  if (!state.mercoxit?.[key] || JSON.stringify(next)!==JSON.stringify(row)) mutateState(s=>{ (s.mercoxit ||= {})[key]=next; });
  mercoxitWake(key,next.deadline);
  return active || next.ready>0 ? next : null;
}
internals.mercoxitEnabled = () => config.mercoxit === true;
internals.mercoxitDefinition = (hub, now, build, template) => {
  if (!config.mercoxit || !template || hub.upgradeTier!==3) return null;
  try {
    const marked={...hub,nullsecMercoxit:true};
    const active=getDungeonRuntime().listInstancesBySystem(hub.sourceSystemID,{full:true}).find(s=>isMercoxitSite(s)&&mercoxitKey(sovHubOf(s))===mercoxitKey(hub)&&['active','seeded','paused'].includes(s.lifecycleState));
    const row=mercoxitPlan(marked,now,!!active);
    if (!row) return null;
    const system=hub.sourceSystemID,key=mercoxitKey(hub),rotation=active?Number(active.metadata?.rotationIndex||0):row.rotation;
    let slot=active?Number(active.metadata?.slotIndex):row.slot;
    if(!active && logicalReady()) {
      const rows=getDungeonRuntime().listInstancesBySystem(system);
      const reserved=new Set(Object.entries(loadState().mercoxit||{}).filter(([k])=>k!==key&&k.startsWith(`${system}:`)).map(([,v])=>v.slot));
      const helper=universeHelpers(getUniverseRuntime());
      slot=selectFreeSlot({rows,system,preferred:row.slot,first:100,last:499,rotation,claimed:reserved,siteID:helper.buildUniverseSiteID,placement:helper.buildUniverseSitePlacement});
      if(slot===null)return null;
      if(slot!==row.slot)mutateState(s=>{s.mercoxit[key].slot=slot;});
    }
    return build(template,'sov_prospecting',system,slot,now,marked,{rotationIndex:rotation, label:'Enormous Mercoxit Deposit',tags:['prospecting','mercoxit'],siteLifetimeMinutes:525600});
  } catch(e) { warn(`Mercoxit definition skipped: ${e.message}`); return null; }
};
function mercoxitChange(change,site) {
  if (!config.mercoxit) return;
  const key=mercoxitKey(sovHubOf(site)), now=Date.now();
  if (change.changeType==='created') {
    const row=loadState().mercoxit?.[key];
    if (!row || row.lastInstance===site.instanceID) return;
    mutateState(s=>{const r=s.mercoxit[key]; r.ready=Math.max(0,r.ready-1); r.lastInstance=site.instanceID; r.rotation=Number(site.metadata?.rotationIndex||0); mercoxitAdvance(r,now,true);});
    mercoxitWake(key,loadState().mercoxit[key].deadline);
    if(verbose){const reserves=loadState().mercoxit[key].ready;diagnostics.mark('mercoxit',Number.isSafeInteger(reserves)&&reserves>=0&&reserves<=config.mercoxitMax?null:false,'Native Mercoxit created; reserve capacity checked; timing pending');log(`Mercoxit spawned in ${site.solarSystemID}; reserves ${reserves}.`);}
  } else if (change.changeType==='updated' && change.after?.lifecycleState==='completed' && change.before?.lifecycleState!=='completed' && change.after.lifecycleReason==='depleted') {
    mutateState(s=>{const r=s.mercoxit?.[key]; if(!r)return; r.rotation++; mercoxitAdvance(r,now,false);});
    mercoxitWake(key,now);
  } else if (change.changeType==='removed') {
    mercoxitWake(key,now);
  }
}
function patchMercoxit(source) {
  const start=source.indexOf('function buildProspectingDefinitionsForSystem('),end=source.indexOf('\nfunction listSovereigntySourceSystemIDs()',start);
  if(start<0||end<0)throw new Error('Mercoxit definition anchor missing');
  let section=source.slice(start,end);
  const a='  for (const upgrade of upgrades) {';
  if(section.split(a).length!==2)throw new Error('Mercoxit upgrade anchor mismatch');
  section=section.replace(a,a+`
    if (upgrade.tier === 3 && globalThis.__nullsecUpgrades.mercoxitEnabled()) {
      const hub = {provider:"sov_hub",upgradeCategory:"prospecting",mineral:upgrade.mineral,upgradeTier:upgrade.tier,upgradeTypeID:toInt(upgrade.upgrade && upgrade.upgrade.typeID,0)||null,upgradeName:normalizeText(upgrade.upgrade && upgrade.upgrade.name,""),sourceSystemID:systemID,sourceHubID:normalizedContext.sovereignty.hubID,targetSystemID:systemID,jumpsFromSource:0,sourceRefs:["ccpSovHub","ccpEquinoxSovUpdates"]};
      const mercoxit=globalThis.__nullsecUpgrades.mercoxitDefinition(hub,nowMs,buildSovGuaranteedDefinition,dungeonAuthority.listTemplatesByFamily("ore").find(t=>t.templateID==="client-dungeon:12986"));
      if(mercoxit) definitions.push(mercoxit);
    }`);
  source=source.slice(0,start)+section+source.slice(end);
  const b='  const spawnFamilyKey = normalizeLowerText(\n    instance && instance.metadata && instance.metadata.spawnFamilyKey,';
  if(source.split(b).length!==2)throw new Error('Mercoxit rotation anchor unavailable');
  return source.replace(b,'  if (instance?.metadata?.sovHub?.nullsecMercoxit === true) return null;\n'+b);
}

function scheduleCooldown(key, deadline) { setDeadline('cooldown',key,deadline); }
function recordCooldown(site, deadline) {
  const key = upgradeKey(site);
  if (!key) return;
  const hub=Number(sovHubOf(site)?.sourceHubID), id=Number(site.instanceID), next=Number(site.metadata?.rotationIndex||0)+1;
  const previous=loadState().rotations?.[key];
  if(previous?.hub===hub && Number(previous.lastInstance)>=id)return;
  mutateState(state=>{state.cooldowns[key]=deadline;(state.rotations||={})[key]={hub,lastInstance:id,next:Math.max(next,previous?.hub===hub?Number(previous.next)||0:0)};});
  scheduleCooldown(key,Math.max(1,deadline));
}
function activeEscalations(runtime, systemID) {
  return runtime.listInstancesBySystem(systemID, { full: true }).filter(site => site.siteOrigin === ESCALATION_ORIGIN && ["active", "seeded", "paused"].includes(site.lifecycleState) && Number(site.timers?.expiresAtMs || Infinity) > Date.now());
}
function enqueueRoll(parent) {
  const tier = parent.siteOrigin === ESCALATION_ORIGIN ? 3 : prospectingTier(parent);
  const chance = Math.min(100, chanceForTier(tier) + indexBenefits.escalationBonus(parent.solarSystemID));
  if (verbose) diagnostics.mark("indexEscalation", Number.isFinite(chance)&&chance>=0&&chance<=100?null:false,"Effective probability arithmetic checked");
  const id = Number(parent.instanceID);
  const runtime = getDungeonRuntime();
  if (!config.escalations || !id || parent.spawnState?.nullsecEscalationRolled) return;
  // Persist the decision with the queue before marking the parent. A queued parent ID is idempotent.
  let roll;
  mutateState(state => {
    state.rolls ||= {};
    if (Object.hasOwn(state.rolls, id)) { roll = state.rolls[id]; return; }
    roll = Math.random() * 100;
    state.rolls[id] = roll;
    if (roll < chance) state.queue[parent.solarSystemID] = (state.queue[parent.solarSystemID] || 0) + 1;
  });
  runtime.mergeSpawnState(id, { nullsecEscalationRolled: true, nullsecEscalationRolledAtMs: Date.now() }, { durable: true });
  mutateState(state => { delete state.rolls[id]; });
  if (verbose) diagnostics.mark("escalations", Number.isFinite(roll)&&roll>=0&&roll<100?null:false,"Depletion roll persisted and parent marked; successful creation awaiting evidence");
  if (verbose) log(`Site ${id} depleted: escalation roll ${roll.toFixed(2)} / ${chance}%.`);
}
const pendingDrains = new Set();
function requestDrain(systemID) {
  if (!config.escalations || !systemID || pendingDrains.has(systemID)) return;
  pendingDrains.add(systemID);
  setImmediate(() => {
    pendingDrains.delete(systemID);
    try {
      const runtime = getDungeonRuntime();
      while (activeEscalations(runtime, systemID).length < 2) {
        if (!(loadState().queue[systemID] > 0)) break;
        // Reserve before spawning; restore on synchronous failure. No queued site data.
        mutateState(state => { if (--state.queue[systemID] === 0) delete state.queue[systemID]; });
        try {
          const created = spawnEscalation({ instanceID: 0, solarSystemID: systemID, siteOrigin: 'sov_hub', spawnState: { sovHub: { upgradeCategory: 'prospecting', upgradeTier: 3 } } });
          if (!created?.instanceID) throw new Error('escalation creation returned no instance');
          if(verbose){const stored=runtime.getInstance(created.instanceID);diagnostics.mark('escalations',stored?.siteOrigin===ESCALATION_ORIGIN&&activeEscalations(runtime,systemID).length<=2?null:false,'Queued site created and read back; persistence across restart pending');log(`Queued escalation spawned as ${created.instanceID}.`);}
        } catch(error) { mutateState(state => { state.queue[systemID] = (state.queue[systemID] || 0) + 1; }); throw error; }
      }
    } catch (error) { warn(`Escalation queue drain failed: ${error.message}`); }
  });
}
function recoverPersistentWork() {
  try {
    const state = loadState();
    for (const [key, deadline] of Object.entries(state.cooldowns)) scheduleCooldown(key, Number(deadline));
    if (config.escalations) for (const id of Object.keys(state.rolls || {})) {
      const parent = getDungeonRuntime().getInstance(Number(id));
      if (parent?.lifecycleState === "completed" && !parent.spawnState?.nullsecEscalationRolled) enqueueRoll(parent);
      else mutateState(next => { delete next.rolls[id]; });
    }
    if (config.escalations) for (const system of Object.keys(state.queue).map(Number)) requestDrain(system);
  } catch (error) { warn(`Persistent recovery skipped: ${error.message}`); }
}


function chanceForTier(tier) {
  return config.chances[tier] || 0;
}

// The site-ID and placement helpers are only exported under _testing.
function universeHelpers(universeRuntime) {
  return (universeRuntime && universeRuntime._testing &&
    typeof universeRuntime._testing.buildUniverseSiteID === "function") ? universeRuntime._testing : universeRuntime;
}

// Identity the client needs to name the site "Interstitial Ore Deposit". The
// rocks come from the reference ore template; the name comes from the client's
// own dungeon record (falling back to the values read from the static data).
function resolveEscalationIdentity(universeRuntime) {
  const authority = require(path.join(universeRuntime.__dir, "dungeonAuthority"));
  const read = authority.getTemplateByIDReadOnly || authority.getTemplateByID;
  const reference = read.call(authority, ESCALATION_TEMPLATE_ID);
  if (!reference) {
    throw new Error(`template ${ESCALATION_TEMPLATE_ID} not found (is the ore anomalies content pack installed?)`);
  }
  if (!reference.populationHints || !Array.isArray(reference.populationHints.miningRocks) ||
      reference.populationHints.miningRocks.length === 0) {
    throw new Error("the Interstitial Ore Deposit template has no ore rocks");
  }
  let client = null;
  try { client = read.call(authority, ESCALATION_CLIENT_TEMPLATE_ID); } catch (_) { /* optional */ }
  if (client && String(client.resolvedName || "").toLowerCase() !== "interstitial ore deposit") client = null;
  return {
    reference,
    dungeonNameID: toInt(client && client.dungeonNameID, 0) || ESCALATION_FALLBACK_NAME_ID,
    clientDungeonID: toInt(client && client.sourceDungeonID, 0) || ESCALATION_FALLBACK_DUNGEON_ID,
  };
}

function buildEscalationSite(dungeonRuntime, universeRuntime, parent, now, characterIDs = []) {
  const adapter = require(path.join(universeRuntime.__dir, "dungeonSiteAdapter"));
  const identity = resolveEscalationIdentity(universeRuntime);
  const template = identity.reference;
  const systemID = toInt(parent.solarSystemID, 0);
  const used = new Set();
  for (const instance of dungeonRuntime.listInstancesBySystem(systemID, { full: true })) {
    const siteID = toInt(instance && instance.metadata && instance.metadata.siteID, 0);
    if (siteID > 0 && instance.metadata && instance.metadata.nullsecEscalation === true) used.add(siteID);
  }
  let slot = -1;
  let siteID = 0;
  for (let candidate = ESCALATION_SLOT_FIRST; candidate <= ESCALATION_SLOT_LAST; candidate += 1) {
    const id = universeHelpers(universeRuntime).buildUniverseSiteID("sov_prospecting", systemID, candidate);
    if (id > 0 && !used.has(id)) { slot = candidate; siteID = id; break; }
  }
  if (slot < 0) throw new Error("no free escalation slot in this system");

  const placement = universeHelpers(universeRuntime).buildUniverseSitePlacement(systemID, "sov_prospecting", slot, 0);
  const providerID = "sceneAnomalySite";
  const clone = (value) => JSON.parse(JSON.stringify(value === undefined ? null : value));
  const label = String(template.resolvedName || template.title || "Interstitial Ore Deposit");
  const anchor = {
    anchorItemID: toInt(placement && placement.anchorItemID, 0) || null,
    anchorDistanceMeters: Math.round(Number(placement && placement.anchorDistanceMeters) || 0),
    anchorDistanceAu: Number((Number(placement && placement.anchorDistanceAu) || 0).toFixed(3)),
  };
  const spawnState = {
    siteID,
    slotIndex: slot,
    rotationIndex: 0,
    spawnFamilyKey: ESCALATION_FAMILY,
    label,
    lifetimeMs: ESCALATION_LIFETIME_MS,
    populationHints: withTopGradeOre(template.populationHints),
    ...anchor,
    nullsecEscalation: {
      tier: prospectingTier(parent) || 3,
      parentInstanceID: toInt(parent.instanceID, 0),
      clientDungeonID: identity.clientDungeonID,
      characterIDs,
      createdAtMs: now,
    },
  };
  const metadata = {
    providerID,
    siteID,
    slotIndex: slot,
    rotationIndex: 0,
    spawnFamilyKey: ESCALATION_FAMILY,
    label,
    universeSeededAtMs: now,
    ...anchor,
    nullsecEscalation: true,
  };
  return {
    options: {
      templateID: template.templateID,
      solarSystemID: systemID,
      siteKey: adapter.buildSiteKey(providerID, systemID, siteID),
      lifecycleState: "active",
      instanceScope: "shared",
      siteFamily: template.siteFamily || "ore",
      siteKind: template.siteKind || "anomaly",
      siteOrigin: ESCALATION_ORIGIN,
      position: placement.position,
      nowMs: now,
      activatedAtMs: now,
      expiresAtMs: now + ESCALATION_LIFETIME_MS,
      roomStatesByKey: {
        "room:entry": {
          roomKey: "room:entry", state: "active", stage: "entry", pocketID: null, nodeGraphID: null,
          activatedAtMs: now, completedAtMs: 0, lastUpdatedAtMs: now, spawnedEntityIDs: [], counters: {},
          metadata: { lightweight: true },
        },
      },
      gateStatesByKey: {},
      objectiveState: {
        state: "pending", currentNodeID: null, currentObjectiveID: null,
        completedObjectiveIDs: [], completedNodeIDs: [], counters: {}, metadata: { lightweight: true },
      },
      environmentState: { seededAtMs: now, templateRef: template.templateID, lightweight: true },
      spawnState,
      runtimeFlags: { universeSeeded: true, universePersistent: true, lazyMaterialized: true, nullsecEscalation: true },
      metadata,
      durable: true,
    },
    dungeonNameID: identity.dungeonNameID,
  };
}

// The server copies a site's identity from its template when it creates the
// instance. For this one call the template is handed over with the client's
// Interstitial Ore Deposit name ID, so the site is stored with its proper name.
function createEscalationInstance(universeRuntime, built) {
  const authority = require(path.join(universeRuntime.__dir, "dungeonAuthority"));
  const originals = {};
  for (const key of ["getTemplateByID", "getTemplateByIDReadOnly"]) {
    originals[key] = authority[key];
    if (typeof originals[key] !== "function") continue;
    authority[key] = function derivedTemplateLookup(...args) {
      const template = originals[key].apply(this, args);
      return template && template.templateID === ESCALATION_TEMPLATE_ID
        ? { ...template, dungeonNameID: built.dungeonNameID }
        : template;
    };
  }
  try {
    return getDungeonRuntime().createInstance(built.options);
  } finally {
    for (const key of Object.keys(originals)) if (typeof originals[key] === "function") authority[key] = originals[key];
  }
}

// Request scoped reconciliation only. Native occupancy grace remains the sole grid cleanup authority.
const pendingReconciles = new Set();
function requestReplacementReconcile(instance) {
  if (!instance || (!isProspectingSite(instance) && !isMercoxitSite(instance))) return;
  const system = Number(instance.solarSystemID);
  if (!system || pendingReconciles.has(system)) return;
  pendingReconciles.add(system);
  setImmediate(() => {
    pendingReconciles.delete(system);
    try { getUniverseRuntime().scheduleSystemUniversePersistentSitesReconcile(system,{reason:'nullsec-depletion',families:['sov_prospecting'],force:true,debounceMs:0}); }
    catch (e) { warn(`Replacement reconcile failed: ${e.message}`); }
  });
}

function makeInstanceListener(dungeonRuntime, getUniverseRuntime) {
  return function onInstanceChange(change) {
    try {
      const instance = change?.after || change?.before;
      if (!instance) return;
      if (isMercoxitSite(instance)) { mercoxitChange(change,instance); return; }
      const isEsc = instance.siteOrigin === ESCALATION_ORIGIN;
      const isSov = isProspectingSite(instance);
      if (!isEsc && !isSov) return;
      if (change.changeType === "created" && isSov) {
        const key = upgradeKey(instance);
        const due = key ? Number(loadState().cooldowns[key])||0 : 0;
        if (key && due && due <= Date.now()) mutateState(state => { delete state.cooldowns[key]; });
        if (verbose) {
          const label=String(instance.metadata?.label||'').toLowerCase(), tier=prospectingTier(instance);
          if(config.strictMiningSiteSize)diagnostics.mark('strictSize', tier===1?label.startsWith('small '):tier===3?label.startsWith('large '):! /^(small|large|enormous) /.test(label), 'Native created anomaly label checked');
          const last=key&&loadState().rotations?.[key];
          if(due && last){
            const previous=dungeonRuntime.getInstance(last.lastInstance);
            const distinct=!previous || (previous.metadata?.siteID!==instance.metadata?.siteID && positionClear(instance.position,[previous]));
            const timed=Date.now()>=due;
            diagnostics.mark('respawn',distinct&&timed,'Replacement identity and minimum cooldown checked; physical evacuation handled by native runtime');
            if(config.instantRespawn)diagnostics.mark('instantRespawn',distinct&&timed?null:false,'Replacement created; exact latency and occupied-grid retention require live evidence');
          }else diagnostics.mark('respawn',null,'Native creation observed; no depletion deadline available');
        }
        if (verbose) log(`Array ${prospectingTier(instance)} site ${instance.instanceID} spawned in ${instance.solarSystemID}.`);
      }
      if (isSov && change.changeType === "removed" && managedDepleted(instance)) requestReplacementReconcile(instance);
      if (isEsc && (change.changeType === "removed" || (change.after && !["active", "paused", "seeded"].includes(change.after.lifecycleState)))) requestDrain(instance.solarSystemID);
      // Native completion verifies all authored rock identities and quantities.
      if (change.changeType !== "updated" || change.after?.lifecycleState !== "completed" || change.after.lifecycleReason !== "depleted" || change.before?.lifecycleState === "completed") return;
      if (isSov) {
        const deadline = Number(change.after.timers?.completedAtMs || Date.now()) + internals.respawnDelay(change.after, 0);
        recordCooldown(change.after, deadline);
      }
      if (config.escalations) {
        enqueueRoll(change.after);
        requestDrain(instance.solarSystemID);
      }
    } catch (error) { warn(`Mining lifecycle listener: ${error.message}`); }
  };
}


// --------------------------------------------------------- 4. debug command
const DEBUG_COMMAND = "miningescalation";

function resolveSessionSystemID(session) {
  return toInt(
    (session && session._space && session._space.systemID) ||
    (session && session.solarsystemid2) || (session && session.solarsystemid), 0);
}

// What the forced escalation counts as coming from: a Prospecting Array site in
// the caller's system (Array 3 preferred) or, if there is none, a stand-in Array 3.
function pickDebugParent(dungeonRuntime, systemID) {
  let best = null;
  for (const instance of dungeonRuntime.listInstancesBySystem(systemID, { full: true })) {
    if (String(instance.siteOrigin || "").toLowerCase() !== "sov_hub" || !isProspectingSite(instance)) continue;
    if (!best || prospectingTier(instance) > prospectingTier(best)) best = instance;
  }
  if (best) return { parent: best, source: `Prospecting Array ${prospectingTier(best) || "?"} site ${best.instanceID}` };
  return {
    parent: {
      instanceID: 0,
      solarSystemID: systemID,
      spawnState: { sovHub: { upgradeCategory: "prospecting", upgradeTier: 3 } },
      metadata: {},
    },
    source: "a stand-in Prospecting Array 3 (none in this system)",
  };
}

function forceEscalation(session) {
  let dungeonRuntime;
  let universeRuntime;
  try {
    dungeonRuntime = getDungeonRuntime();
    universeRuntime = getUniverseRuntime();
  } catch (error) {
    throw new Error(`could not reach the dungeon runtime (${error.message})`);
  }
  if (!dungeonRuntime || !universeRuntime) throw new Error("dungeon runtime is not available");
  const systemID = resolveSessionSystemID(session);
  if (systemID <= 0) throw new Error("you must be in a solar system (undock first)");
  const { parent, source } = pickDebugParent(dungeonRuntime, systemID);
  const created = spawnEscalation(parent, session);
  log(`Debug escalation forced in system ${systemID} (as if from ${source}) as site ${created && created.instanceID}.`);
  return `Mining escalation forced in this system: Interstitial Ore Deposit, site ${created && created.instanceID} ` +
    `(as if from ${source}), open for 24 hours. Check your probe scanner / anomaly list.`;
}


// ------------------------------------------------ /nukeminingsites
const NUKE_COMMAND = "nukeminingsites";
const NUKE_CHUNK_SIZE = 20;

// Mining sites: ore, ice and gas sites the game spawns by itself (generated belts,
// universe anomalies, Prospecting Array sites) and mining escalation sites.
// Escalation sites are removed but not respawned: they only come from mining.
function listNukeableMiningSites(dungeonRuntime, systemID) {
  const byID = new Map();
  for (const state of SITE_STATES) {
    for (const instance of dungeonRuntime.listInstancesByLifecycle(state, { full: true })) {
      const id = toInt(instance && instance.instanceID, 0);
      const system = toInt(instance && instance.solarSystemID, 0);
      if (id <= 0 || system <= 0 || (systemID && system !== systemID)) continue;
      if (!(instance.runtimeFlags && instance.runtimeFlags.universeSeeded === true)) continue;
      if (!isProspectingSite(instance) && instance.siteOrigin !== ESCALATION_ORIGIN) continue;
      byID.set(id, system);
    }
  }
  return byID;
}

function respawnSystem(universeRuntime, systemID) {
  const result = universeRuntime.prepareSystemForPlayerEntry(systemID, { force: true, reason: "nukeminingsites" });
  if (!result || result.success === false) {
    throw new Error(`respawn failed in system ${systemID}: ${result && result.errorMsg || "unknown error"}`);
  }
  const summary = result.reconcile && result.reconcile.summary;
  return Math.max(0, toInt(summary && summary.createdInstances, 0));
}

function tellSession(session, message) {
  try {
    const chatHub = require(path.join(SERVER_SERVICES, "chat", "chatHub"));
    chatHub.sendSystemMessage(session, message);
  } catch (_) { /* the log line still has it */ }
}

function clearCooldownsFor(systemID) {
  mutateState(state => {
    for (const key of Object.keys(state.cooldowns)) if (!systemID || key.startsWith(`${systemID}:`)) delete state.cooldowns[key];
  });
  for (const [key,row] of deadlines) if (key.startsWith("cooldown:") && (!systemID || row.system === Number(systemID))) deadlines.delete(key); armDeadlines();
}
function nukeMiningSites(session, scope) {
  const dungeonRuntime = getDungeonRuntime();
  const universeRuntime = getUniverseRuntime();
  if (scope === "local") {
    const systemID = resolveSessionSystemID(session);
    if (systemID <= 0) throw new Error("you must be in a solar system (undock first)");
    const sites = listNukeableMiningSites(dungeonRuntime, systemID);
    clearCooldownsFor(systemID);
    const removed = sites.size > 0 ? toInt(dungeonRuntime.purgeInstances([...sites.keys()], { source: "nukeminingsites" }).removedCount, 0) : 0;
    const created = respawnSystem(universeRuntime, systemID);
    log(`/${NUKE_COMMAND} local: system ${systemID}, removed ${removed}, respawned ${created}.`);
    return `Nuked sovereignty mining sites and mining escalations in this system: removed ${removed}, ${created} respawned.`;
  }

  const sites = listNukeableMiningSites(dungeonRuntime, 0);
  clearCooldownsFor(0);
  const systemIDs = [...new Set(sites.values())].sort((a, b) => a - b);
  const removed = sites.size > 0 ? toInt(dungeonRuntime.purgeInstances([...sites.keys()], { source: "nukeminingsites" }).removedCount, 0) : 0;
  log(`/${NUKE_COMMAND} all: removed ${removed} mining sites in ${systemIDs.length} systems; respawning in the background.`);
  // Respawn a few systems per tick so the server keeps answering players.
  let index = 0;
  let created = 0;
  let failed = 0;
  const step = () => {
    const end = Math.min(index + NUKE_CHUNK_SIZE, systemIDs.length);
    for (; index < end; index += 1) {
      try { created += respawnSystem(universeRuntime, systemIDs[index]); } catch (error) {
        failed += 1;
        warn(error.message);
      }
    }
    if (index < systemIDs.length) { setImmediate(step); return; }
    const done = `Nuke finished: removed ${removed} mining sites, ${created} respawned across ${systemIDs.length} systems` +
      `${failed ? ` (${failed} systems failed, see the server console)` : ""}.`;
    log(done);
    tellSession(session, done);
  };
  setImmediate(step);
  return `Nuking ${removed} mining sites across ${systemIDs.length} systems. Respawning in the background; ` +
    "you will get a message when it is done.";
}

// A forced check also inspects whether the relevant *live* hook is attached.
// It never calls native mutations or loads new world data to establish readiness.
function debugHookReadiness(key) {
  if(!diagnosticOwner())return {status:'Not ready',detail:'Diagnostics disabled'};
  const flag=k=>debugNativeHooks?.get(k)===true;
  const result=(ok,detail)=>({status:ok?'Ready':'Not ready',detail});
  const lifecycle=logicalReady()&&flag('replacement')&&flag('visibility')&&listenerHooked&&!!dungeonRuntimeModule&&!!universeRuntimeModule;
  switch(key){
    case 'escalations':return result(listenerHooked&&!!dungeonRuntimeModule&&!!universeRuntimeModule&&explorationHooked,'Depletion listener, dungeon runtimes and Journal hook');
    case 'oreScaling':return result(!config.anyMultiplier||flag('oreScaling'),config.anyMultiplier?'Live quantity transform':'All multipliers are 1; native quantities retained');
    case 'strictSize':return result(flag('strictSize'),'Live strict selector transform');
    case 'tierDistribution':case 'arrayDistribution':case 'tierRandomness':return result(flag('tierDistribution')&&typeof internals.itemByTypeID==='function','Live ore-type transform and native item-volume lookup');
    case 'initialSpawn':return result(flag('initialSpawn'),'Native first-spawn wait policy transform');
    case 'respawn':case 'instantRespawn':return result(lifecycle,'Live replacement plan, scanner visibility and depletion listener');
    case 'mercoxit':return result(lifecycle&&flag('mercoxit'),'Live Mercoxit definition and replacement hooks');
    case 'planetaryResources':return result(flag('resources'),'Live local resource transform');
    case 'industrialProgression':case 'industrialDecay':return result(industrialIndex.debugReady(key),'Live sovereignty, settlement timer and required ledger/shutdown hooks');
    case 'indexPoints':case 'indexEscalation':case 'indexResources':return result(indexBenefits.debugReady()&&(key!=='indexResources'||flag('resources')),'Live sovereignty snapshot'+(key==='indexResources'?' and local resource transform':''));
    case 'reset':return result(resetHooked&&!!dungeonRuntimeModule,'Live scoped startup reset hook');
    case 'commands':return result(commandsHooked,'Live staff command dispatch hook');
    case 'verbose':return result(!!diagnosticState,'World-owner diagnostics initialized');
    default:return result(false,'Unknown feature');
  }
}

function inspectLive(system,keys) {
  if(!diagnosticOwner())return {};
  const output={}, now=Date.now(), selected=new Set(keys);
  const put=(key,ok,detail)=>{if(selected.has(key))output[key]={status:ok===null?'Pending':ok?'Passed':'Failed',detail,at:now,system};};
  try {
    const rows=dungeonRuntimeModule?.listInstancesBySystem(system)||[], active=rows.filter(r=>isProspectingSite(r)&&['active','seeded','paused'].includes(r.lifecycleState));
    const journal=loadState(), prefix=system+':';
    const deadlines=Object.entries(journal.cooldowns).filter(([k])=>k.startsWith(prefix));
    const reserves=Object.entries(journal.mercoxit||{}).filter(([k])=>k.startsWith(prefix));
    const liveMercoxit=rows.filter(r=>isMercoxitSite(r)&&['active','seeded','paused'].includes(r.lifecycleState));
    put('respawn',deadlines.length?deadlines.every(([,v])=>Number.isFinite(v)&&v>=0):null,`${active.length} active; ${deadlines.length} cooldowns; ${deadlines.map(([k,v])=>k.split(':')[1]+': '+Math.max(0,Math.ceil((v-now)/1000))+'s').join(', ')}`);
    put('instantRespawn',null,`${active.length} active; replacement latency requires a real depletion`);
    put('initialSpawn',null,'Native gate '+(debugNativeHooks?.get('initialSpawn')?'installed':'not confirmed')+'; live new installation not observed');
    put('mercoxit',reserves.length?reserves.every(([,r])=>Number.isSafeInteger(r.ready)&&r.ready>=0&&r.ready<=config.mercoxitMax):null,`${liveMercoxit.length} active; ${reserves.map(([k,r])=>k.split(':')[1]+': '+r.ready+'/'+config.mercoxitMax).join(', ')||'no reserve record'}`);
    const sizes=active.map(r=>{const name=String(r.metadata?.label||r.spawnState?.label||'').toLowerCase(), tier=prospectingTier(r);return {name,tier,ok:tier===1?name.startsWith('small '):tier===3?name.startsWith('large '):tier===2&&!/^(small|large|enormous) /.test(name)&&!!name};});
    put('strictSize',sizes.length?sizes.every(r=>r.ok):null,`${sizes.filter(r=>r.ok).length}/${sizes.length} existing Array sites match size (older retained sites may differ)`);
    const escalations=rows.filter(r=>r.siteOrigin===ESCALATION_ORIGIN&&['active','seeded','paused'].includes(r.lifecycleState));
    put('escalations',null,`${escalations.length} active incl. staff sites; ${Number(journal.queue[system])||0} queued; live roll evidence separate`);
    if(['oreScaling','tierDistribution','arrayDistribution','tierRandomness'].some(k=>selected.has(k))){
      let count=0,invalid=0,baseVolume=0,scaledVolume=0,gradeVolume=[0,0,0,0],remainingGrades=[0,0,0,0],eligible=0,liveCount=0,liveMismatch=0,gradeMismatch=0,gradeSites=0,limited=active.length>16;
      const scene=require.cache[path.resolve(SERVER_SERVICES,'../space/runtime.js')]?.exports?.scenes?.get(system);
      for(const summary of active.slice(0,16)){
        const site=dungeonRuntimeModule.getInstance(summary.instanceID);if(!site)continue;
        const hints=site.spawnState?.populationHints;if(!hints?.miningRocks||!internals.debugRockDescriptors)continue;
        if(hints.miningRocks.length>5000||hints.miningRocks.reduce((n,r)=>n+Math.max(1,Number(r?.count)||1),0)>5000){limited=true;continue;}
        const before=internals.debugRockDescriptors(site,hints,true), after=internals.debugRockDescriptors(site,hints,false);
        if(before.length!==after.length){invalid++;continue;}
        if(count+after.length>5000){limited=true;break;}
        const siteGrades=[0,0,0,0];let siteEligible=0;
        for(let i=0;i<after.length;i++){
          if(count>=5000){limited=true;break;}
          const b=before[i], a=after[i], mult=config.multipliers[prospectingTier(site)]||1, expected=mult===1?b.quantity:b.quantity>0?Math.min(Number.MAX_SAFE_INTEGER,Math.max(1,Math.round(b.quantity*mult))):b.quantity;
          if(a.quantity!==expected)invalid++;
          const volume=a.quantity*unitVolumeOf(a.oreTypeID);baseVolume+=b.quantity*unitVolumeOf(b.oreTypeID);scaledVolume+=volume;count++;
          const family=ORE_FAMILY_BY_TYPE.get(a.oreTypeID);if(family){gradeVolume[family.indexOf(a.oreTypeID)]+=volume;siteGrades[family.indexOf(a.oreTypeID)]+=volume;siteEligible+=volume;eligible++;}
          const entity=scene?.getEntityByID(a.entityID);if(entity?.dungeonSiteInstanceID===site.instanceID){liveCount++;if(Number(entity.miningOriginalQuantity)!==a.quantity||Number(entity.miningYieldTypeID)!==a.oreTypeID)liveMismatch++;const liveFamily=ORE_FAMILY_BY_TYPE.get(Number(entity.miningYieldTypeID));if(liveFamily)remainingGrades[liveFamily.indexOf(Number(entity.miningYieldTypeID))]+=Math.max(0,Number(entity.miningRemainingQuantity)||0)*unitVolumeOf(Number(entity.miningYieldTypeID));}
        }
        if(siteEligible>0 && config.tierMix){
          const seed=`${site.instanceID||site.metadata?.siteID}:${site.timers?.createdAtMs||0}:${hints.miningRocks.length}`;let counter=0;
          const target=mixFor(prospectingTier(site),()=>hashFraction(`${seed}:${counter++}`));
          // Whole declared rows share one grade; a row's volume is the achievable rounding tolerance.
          const largest=Math.max(0,...hints.miningRocks.map(r=>Math.max(1,Number(r?.count)||1)*Math.max(1,Number(r?.quantity??r?.remainingQuantity??r?.quantityPerRock)||1)*unitVolumeOf(Number(r?.typeID||r?.oreTypeID))*config.multipliers[prospectingTier(site)]));
          if(target.some(t=>Math.abs(siteGrades[t.grade]-t.share*siteEligible)>largest+1))gradeMismatch++;
          gradeSites++;
        }
      }
      put('oreScaling' ,count?invalid===0&&liveMismatch===0:null,`${count} native descriptors: ${Math.round(baseVolume)} -> ${Math.round(scaledVolume)} m3; ${invalid} mismatch; ${liveCount} materialized checked (${liveMismatch} mismatch)${limited?' (bounded sample)':''}`);
      const total=gradeVolume.reduce((a,b)=>a+b,0);const mix=total?gradeVolume.slice().reverse().map(v=>(100*v/total).toFixed(1)).join('/'):'n/a';
      const remTotal=remainingGrades.reduce((a,b)=>a+b,0), rem=remTotal?remainingGrades.slice().reverse().map(v=>(100*v/remTotal).toFixed(1)).join('/'):'n/a';
      for(const key of ['tierDistribution','arrayDistribution','tierRandomness'])put(key,gradeSites?gradeMismatch===0&&liveMismatch===0:null,`${gradeSites} sites, ${gradeMismatch} outside row-volume tolerance; generated IV/III/II/I % ${mix}; ${liveCount} live rocks, remaining % ${rem}${limited?' (bounded sample)':''}`);
    }
    if(selected.has('planetaryResources')||selected.has('indexResources')){
      const r=internals.debugResourceSnapshot?.(system), idx=indexBenefits.debugSnapshot(system), n=config.indexResources?(idx?.cached||0):0;
      const p=r&&Math.round(r.power*(1+n/100)), w=r&&Math.round(r.workforce*(1+n/100));
      const ok=r? r.actual.power.localHarvest===p&&r.actual.workforce.localHarvest===w&&r.actual.workforce.available===Math.max(0,w+r.transfer):null;
      for(const key of ['planetaryResources','indexResources'])put(key,ok,r?`Expected local ${p}/${w}; native ${r.actual.power.localHarvest}/${r.actual.workforce.localHarvest}; transfer ${r.transfer}; cached bonus ${n}%`:'No cached native hub resource snapshot');
    }
    const idx=indexBenefits.debugSnapshot(system);
    put('indexPoints',idx?Number.isInteger(idx.live)&&idx.live===idx.industrial+idx.military+idx.strategic:null,idx?`Industrial ${idx.industrial}; military ${idx.military}; strategic ${idx.strategic}; live ${idx.live}; cached ${idx.cached}`:'No claimed system snapshot');
    put('indexEscalation',idx&&idx.cached!==null?Number.isInteger(idx.cached)&&idx.cached>=0&&idx.cached<=15:null,idx?`Cached bonus ${idx.cached}; effective chances ${[1,2,3].map(t=>Math.min(100,chanceForTier(t)+idx.cached)).join('/')}%`:'No cached index snapshot');
    const industrial=industrialIndex.debugSnapshot(system);
    for(const key of ['industrialProgression','industrialDecay'])put(key,industrial?.saved?industrial.current===industrial.saved.points:null,industrial?`Native ${industrial.current}; journal ${industrial.saved?.points??'none'}; pending ${industrial.pending} m3`:'No claimed industrial index snapshot');
  }catch(e){for(const key of keys)if(!output[key])put(key,null,'Read-only inspection unavailable: '+String(e.message||e).slice(0,120));}
  for(const key of keys)if(!output[key])put(key,null,'No non-mutating live check available; forced and hook results are separate.');
  return output;
}
function tryHandleDebugCommand(commandsDir, session, rawMessage, chatHub, options) {
  const text = String(rawMessage || "").trim();
  if (!text.startsWith("/")) return null;
  const parts = text.slice(1).trim().split(/\s+/);
  const name = (parts[0] || "").toLowerCase();
  if(name === "nullsecindexsnapshot") {
    const {hasStaffDebugRole}=require(path.join(commandsDir,"commandAccess"));
    if(!diagnosticOwner() || !hasStaffDebugRole(session)) return {handled:true,returnValue:JSON.stringify({available:false,authorized:false})};
    try {
      const view=(parts[1]||'index').toLowerCase();
      if (view === 'test') {
        const d=activeDiagnostics();
        const requested=parts[2] || 'all';
        const enabled=d.snapshot().map(row=>row.key);
        const keys=requested==='all'?enabled:enabled.filter(key=>key===requested);
        if (!keys.length) return {handled:true,returnValue:JSON.stringify({authorized:true,available:true,features:d.snapshot(),message:'No matching enabled feature.'})};
        const now=Date.now();
        if(forcedJob) return {handled:true,returnValue:JSON.stringify({authorized:true,available:true,features:d.snapshot(),busy:true,message:'A test is already running.'})};
        if(lastForcedTestAt && now-lastForcedTestAt<500) return {handled:true,returnValue:JSON.stringify({authorized:true,available:true,features:d.snapshot(),message:'Test recently completed; use Refresh or retry.'})};
        const job={keys:keys.slice(),system:resolveSessionSystemID(session),start:now,done:0,passed:0};forcedJob=job;
        const next=()=>{
          try {
          if(!diagnosticOwner()){forcedJob=null;return;}
          const key=job.keys[job.done];
          if(!key){lastForcedTestAt=Date.now();forcedJob=null;log(`Forced checks: ${job.passed}/${job.done} passed in ${lastForcedTestAt-job.start} ms.`);return;}
          const started=Date.now();let result;
          try{result=require('./forced-tests').run({loaderPath:__filename,serverServices:SERVER_SERVICES,rawConfig:debugStartupConfig||{},keys:[key]})[key];}catch(e){result={status:'Failed',detail:String(e.message||e).slice(0,200)};}
          result ||= {status:'Failed',detail:'Test produced no result'};
          d.recordTest(key,{...result,durationMs:Date.now()-started,hook:debugHookReadiness(key)},requested==='all');
          if(result.status==='Passed')job.passed++;job.done++;
          if(job.done===job.keys.length){const live=inspectLive(job.system,job.keys);for(const [k,v] of Object.entries(live))d.recordInspection(k,v);}
          setImmediate(next).unref();
          } catch(e){forcedJob=null;lastForcedTestAt=Date.now();warn(`Forced checks aborted: ${String(e.message||e).slice(0,200)}`);}
        };
        setImmediate(next).unref();
        return {handled:true,returnValue:JSON.stringify({authorized:true,available:true,features:d.snapshot(),busy:true,message:'Tests queued. Refresh to view results.'})};
      }
      if(view==='inspect'&&!forcedJob){const d=activeDiagnostics(), keys=d.snapshot().map(r=>r.key);for(const [k,v] of Object.entries(inspectLive(resolveSessionSystemID(session),keys)))d.recordInspection(k,v);}
      const payload=view==='menu' ? {available:true} : ['validation','inspect'].includes(view)
        ? {available:true,features:diagnostics.snapshot(),busy:!!forcedJob,message:forcedJob?`Tests running: ${forcedJob.done}/${forcedJob.keys.length}`:undefined}
        : {...industrialIndex.snapshot(resolveSessionSystemID(session)),progressionEnabled:config.indexProgression===true};
      return {handled:true,returnValue:JSON.stringify({...payload,authorized:true})};
    } catch (_) {return {handled:true,returnValue:JSON.stringify({available:false,authorized:true})};}
  }
  if (!config.commands) return null;
  if (name !== DEBUG_COMMAND && name !== NUKE_COMMAND && !["nullsecstatus","nullsecdebug","nullsecvalidate","nullsecqueue"].includes(name)) return null;
  const { handledResult } = require(path.join(commandsDir, "commandReplies"));
  const { hasStaffDebugRole } = require(path.join(commandsDir, "commandAccess"));
  const reply = (message) => handledResult(chatHub, session, options, message);
  if (!hasStaffDebugRole(session)) return reply(`/${name} requires a staff/admin role.`);
  try {
    if (verbose && (name===DEBUG_COMMAND || name===NUKE_COMMAND)) diagnostics.mark("commands",null,"Staff command authorization passed; execution awaiting result");
    if (name.startsWith("nullsec") && !verbose) return reply("Diagnostics disabled (Verbose Logging OFF).");
    if (name === "nullsecstatus") return reply(diagnostics.report());
    if (name.startsWith("nullsec")) {
      const id=resolveSessionSystemID(session);
      if(!id) return reply("No current solar system.");
      const state=loadState(), runtime=getDungeonRuntime();
      const sites=runtime.listInstancesBySystem(id,{full:true});
      const queue=state.queue[id]??0;
      const mercoxit=Object.entries(state.mercoxit||{}).filter(([k])=>k.startsWith(id+":"));
      const cooldowns=Object.entries(state.cooldowns).filter(([k])=>k.startsWith(id+":"));
      const active=activeEscalations(runtime,id).length;
      const queueOK=Number.isSafeInteger(queue)&&queue>=0&&mercoxit.every(([,r])=>Number.isSafeInteger(r.ready)&&r.ready>=0&&r.ready<=config.mercoxitMax+1&&Number.isFinite(r.deadline))&&cooldowns.every(([,v])=>Number.isFinite(v)&&v>=0);
      const lines=[`System ${id}; active escalations ${active}; queued ${queue}`,`Mercoxit: ${JSON.stringify(mercoxit)}`,`Cooldown deadlines (epoch ms): ${JSON.stringify(cooldowns)}`,`Queue integrity: ${queueOK?"PASS":"FAIL"}; active limit may be exceeded by staff commands`];
      if(name!=="nullsecqueue") {const points=indexBenefits.getIndexPoints(id), bonus=indexBenefits.escalationBonus(id);lines.push(`Live index points ${points}; cached escalation bonus ${bonus}; effective chances ${[1,2,3].map(t=>Math.min(100,chanceForTier(t)+bonus)).join(" / ")}%`, `Industrial journal: ${JSON.stringify(state.industrialIndex?.[id]||null)}`,`Owned sites: ${sites.filter(s=>isProspectingSite(s)||isMercoxitSite(s)).map(s=>s.instanceID+":"+s.lifecycleState).join(", ")}`);}
      if(name==="nullsecvalidate") lines.push(diagnostics.report(),"Read-only snapshot; pending checks require gameplay evidence.");
      return reply(lines.join("\n"));
    }
    if (name === DEBUG_COMMAND) { const result=forceEscalation(session); if(verbose)diagnostics.mark("commands",true,"Staff escalation command executed");return reply(result); }
    const scope = (parts[1] || "").toLowerCase();
    if (scope !== "local" && scope !== "all") {
      return reply(`Usage: /${NUKE_COMMAND} local (this system only) or /${NUKE_COMMAND} all (the whole universe).`);
    }
    return reply(nukeMiningSites(session, scope));
  } catch (error) {
    warn(`/${name} failed: ${error && error.message || error}`);
    return reply(`/${name} failed: ${error && error.message || error}`);
  }
}

// -------------------------------------------------------------- module hooks
let dungeonRuntimeModule = null;
let universeRuntimeModule = null;
let resetHooked = false;
let listenerHooked = false;
let commandsHooked = false;
let explorationHooked = false;

const SERVER_SERVICES = path.join(EVEJS_ROOT, "server", "src", "services");

function normalizedPath(filename) { return String(filename || "").replace(/\\/g, "/"); }

// The runtimes are used by the command and the notices, so they are fetched on
// demand if the hook has not seen them load (for example because the server
// had already loaded them before this loader ran).
function getDungeonRuntime() {
  if (!dungeonRuntimeModule) hookLoadedModule(require(path.join(SERVER_SERVICES, "dungeon", "dungeonRuntime.js")),
    path.join(SERVER_SERVICES, "dungeon", "dungeonRuntime.js"));
  return dungeonRuntimeModule;
}

function getUniverseRuntime() {
  if (!universeRuntimeModule) hookLoadedModule(require(path.join(SERVER_SERVICES, "dungeon", "dungeonUniverseRuntime.js")),
    path.join(SERVER_SERVICES, "dungeon", "dungeonUniverseRuntime.js"));
  return universeRuntimeModule;
}

// Applies whichever of our hooks belong to this module. Safe to call twice.
const industrialIndex = require("./industrial-index").create({config,loadState,mutateState,log,warn,diagnostics});
function hookLoadedModule(exported, filenameRaw) {
  if (!exported || !isWorldOwner()) return;
  const filename = normalizedPath(filenameRaw);
  industrialIndex.attach(exported, filename);
  indexBenefits.attach(exported, filename);

  // The Journal's escalating-path list: a service class, not a plain object.
  if (!explorationHooked && typeof exported === "function" && exported.prototype &&
      typeof exported.prototype.Handle_GetMyEscalatingPathDetails === "function" &&
      filename.endsWith("/services/dungeon/dungeonExplorationMgrService.js")) {
    explorationHooked = true;
    const serviceDir = path.dirname(filenameRaw);
    const original = exported.prototype.Handle_GetMyEscalatingPathDetails;
    exported.prototype.Handle_GetMyEscalatingPathDetails = function withMiningEscalations(args, session, kwargs) {
      try {
        const rows = escalationRowsFor(session);
        if (rows.length > 0) {
          const { buildRowset } = require(path.join(serviceDir, "..", "_shared", "serviceHelpers"));
          const { buildCachedMethodCallResult } = require(path.join(serviceDir, "..", "cache", "objectCacheRuntime"));
          return buildCachedMethodCallResult(
            buildRowset(["instanceID", "dungeon", "destDungeon", "srcDungeon", "expiryTime", "journalEntryTemplateID"],
              rows, "eve.common.script.sys.rowset.Rowset"),
            { serviceName: this.name, method: "GetMyEscalatingPathDetails", versionCheck: "always" });
        }
      } catch (error) {
        warn(`Could not add mining escalations to the escalating path list: ${error && error.message || error}`);
      }
      return original.apply(this, arguments);
    };
    return;
  }

  if (typeof exported !== "object") return;

  if (!dungeonRuntimeModule && typeof exported.purgeInstances === "function" &&
      typeof exported.createInstance === "function" &&
      typeof exported.registerInstanceChangeListener === "function" &&
      filename.endsWith("/services/dungeon/dungeonRuntime.js")) {
    dungeonRuntimeModule = exported;
    if (typeof exported.rotateUniversePersistentInstances === "function") {
      const rotate = exported.rotateUniversePersistentInstances;
      exported.rotateUniversePersistentInstances = function nullsecRotate(rotations, options = {}) {
        if (logicalReady() || !Array.isArray(rotations)) return rotate.apply(this, arguments);
        const now = Number(options.nowMs ?? Date.now());
        const delayed = [], ready = [];
        for (const row of rotations) {
          const site = row.existingInstance, key = upgradeKey(site);
          if (key && site.lifecycleReason === "depleted" && Number(loadState().cooldowns[key]) > now) delayed.push(site.instanceID);
          else ready.push(row);
        }
        // Fail closed: retain the native terminal grid and do not force-purge a
        // depleted instance just to enforce a custom cooldown.
        return rotate.call(this, ready, options);
      };
      log("Sovereignty depletion lifecycle hook installed.");
    }
    if (typeof exported.reconcileUniverseSeededInstances === "function") {
      const reconcile = exported.reconcileUniverseSeededInstances;
      exported.reconcileUniverseSeededInstances = function nullsecReconcile(definitions, options = {}) {
        if (!Array.isArray(definitions)) return reconcile.apply(this, arguments);
        let filtered = definitions, adjusted = options;
        try {
          const state = loadState(), now = Number(options.nowMs ?? Date.now());
          const preserve = new Set(options.preserveSiteKeys || []);
          const systems = new Set(options.systemIDs || definitions.map(site => site.solarSystemID));
          // No global scan: inspect only systems in the requested native reconcile.
          for (const system of systems) for (const site of exported.listInstancesBySystem(system)) {
            if (site.siteOrigin === ESCALATION_ORIGIN || managedDepleted(site)) preserve.add(site.siteKey);
            const key = upgradeKey(site);
            if (config.strictMiningSiteSize && key && ["active", "seeded", "paused"].includes(site.lifecycleState)) {
              const desired = definitions.find(def => def.siteKey === site.siteKey && upgradeKey(def) === key);
              if (desired && Number(sovHubOf(desired)?.sourceHubID) === Number(sovHubOf(site)?.sourceHubID) && Number(desired.metadata?.rotationIndex || 0) === Number(site.metadata?.rotationIndex || 0)) preserve.add(site.siteKey);
            }
          }
          filtered = definitions.filter(site => {
            const key = upgradeKey(site);
            if (!key || !(Number(state.cooldowns[key]) > now)) return true;
            return false;
          });
          adjusted = { ...options, preserveSiteKeys: [...preserve] };
        } catch (error) { warn(`Cooldown reconciliation skipped: ${error.message}`); }
        return reconcile.call(this, filtered, adjusted);
      };
      log("Sovereignty cooldown reconciliation hook installed.");
    }
    if (!listenerHooked) {
      listenerHooked = true;
      exported.registerInstanceChangeListener(makeInstanceListener(exported, () => universeRuntimeModule || getUniverseRuntime()));
      log("Sovereignty lifecycle listener installed.");
    }
  }

  if (!universeRuntimeModule && typeof exported.resetStartupOrphanedUniverseSites === "function" &&
      filename.endsWith("/services/dungeon/dungeonUniverseRuntime.js")) {
    universeRuntimeModule = exported;
    Object.defineProperty(exported, "__dir", { value: path.dirname(filenameRaw), enumerable: false });
    if (!resetHooked) {
      resetHooked = true;
      const originalSweep = exported.resetStartupOrphanedUniverseSites;
      exported.resetStartupOrphanedUniverseSites = function sweepWithProspectingReset(...args) {
        let resetOK = false;
        if (config.reset) {
          try {
            const removed = resetProspectingSites(getDungeonRuntime());
            mutateState(state => { state.cooldowns = {}; });
            for (const key of deadlines.keys()) if(key.startsWith("cooldown:")) deadlines.delete(key); armDeadlines();
            resetOK = true;
            if (verbose) diagnostics.mark("reset",true,"Reset removal and cooldown clearing completed");
            log(`Reset mining sites: removed ${removed} Prospecting Array sites.`);
          } catch (error) { if (verbose) diagnostics.mark("reset",false,"Reset failed"); warn(`Reset incomplete: ${error.message}`); }
        }
        const finish = value => { if (resetOK) clearResetSwitch(); recoverPersistentWork(); return value; };
        const result = originalSweep.apply(this, args);
        return result && typeof result.then === "function" ? result.then(finish) : finish(result);
      };
    }
  }

  if ((config.commands || verbose) && !commandsHooked && typeof exported.executeChatCommand === "function" &&
      typeof exported.executeClientChatCommand === "function" &&
      filename.endsWith("/services/chat/chatCommands.js")) {
    commandsHooked = true;
    const commandsDir = path.join(path.dirname(filenameRaw), "commands");
    for (const key of ["executeChatCommand", "executeClientChatCommand"]) {
      const original = exported[key];
      exported[key] = function withMiningEscalationDebugCommand(session, rawMessage, chatHub, options = {}) {
        const handled = tryHandleDebugCommand(commandsDir, session, rawMessage, chatHub, options);
        return handled || original.apply(this, arguments);
      };
    }
    log(`/${DEBUG_COMMAND} and /${NUKE_COMMAND} registered (staff only).`);
  }
}

const WATCHED_SUFFIXES = [
  "/services/sovereignty/sovState.js",
  "/services/mining/miningLedgerState.js",
  "/services/dungeon/dungeonRuntime.js",
  "/services/dungeon/dungeonUniverseRuntime.js",
  "/services/dungeon/dungeonExplorationMgrService.js",
  "/services/chat/chatCommands.js",
];

const watchedNames = new Set(WATCHED_SUFFIXES.map(name => path.basename(name, ".js")));
const originalLoad = Module._load;
Module._load = function patchedLoad(request, parent, isMain) {
  const exported = originalLoad.apply(this, arguments);
  if (exported && (typeof exported === "object" || typeof exported === "function") &&
      watchedNames.has(path.basename(String(request), ".js")) && isWorldOwner()) {
    let filename = "";
    try { filename = Module._resolveFilename(request, parent, isMain); } catch (_) { return exported; }
    const normalized = normalizedPath(filename);
    if (WATCHED_SUFFIXES.some((suffix) => normalized.endsWith(suffix))) { try { hookLoadedModule(exported, filename); } catch (error) { warn(`Hook skipped for ${filename}: ${error.message}`); } }
  }
  return exported;
};

// The ore patches (multiplier, tier distribution, escalation rock check) only
// work if they are applied while the site service is compiled.
if ((config.anyMultiplier || config.tierMix) &&
    Object.keys(require.cache || {}).some((name) => normalizedPath(name).endsWith("/services/dungeon/dungeonUniverseSiteService.js"))) {
  warn("The server had already loaded its ore code before this loader ran, so the Prospecting Array multipliers, " +
    "Mining site tier distribution are NOT active. Native depletion listening remains independent.");
}

if (config.strictMiningSiteSize && Object.keys(require.cache || {}).some(name => normalizedPath(name).endsWith("/services/dungeon/dungeonUniverseRuntime.js"))) {
  warn("Strict mining site size cannot attach: universe runtime already compiled. Restart with the loader enabled before runtime initialization.");
}

// Modules the server loaded before this loader ran are hooked from the cache.
for (const [filename, cached] of Object.entries(require.cache || {})) {
  const normalized = normalizedPath(filename);
  if (cached && cached.exports && WATCHED_SUFFIXES.some((suffix) => normalized.endsWith(suffix))) {
    log(`Attaching to an already loaded module: ${path.basename(filename)}`);
    try { hookLoadedModule(cached.exports, filename); } catch (error) { warn(`Cached hook skipped: ${error.message}`); }
  }
}

if (config.reset) log("Reset mining sites is requested for this start.");
if (isWorldOwner()) log("Loaded in world owner.");
